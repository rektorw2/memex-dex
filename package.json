{
  "name": "memex-dex",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "npm run build -w @memex/core && npm run build -w @memex/api && npm run build -w @memex/web",
    "test": "npm run test -w @memex/core && npm run test -w @memex/api",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run build -w @memex/core && npm run dev -w @memex/api",
    "dev:web": "npm run dev -w @memex/web",
    "dev:worker": "npm run build -w @memex/core && npm run worker -w @memex/api",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:drift": "bash scripts/migrations-drift.sh",
    "db:migrations": "bash scripts/migrations-prepare.sh",
    "db:verify": "node scripts/migrations-verify.mjs",
    "db:backfill-snapshots": "tsx apps/api/scripts/snapshots-backfill.ts",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx prisma/create-admin.ts",
    "access:legacy-grant": "tsx apps/api/scripts/grant-legacy-access.ts",
    "access:service-grant": "tsx apps/api/scripts/grant-service-access.ts",
    "trades:backfill": "tsx apps/api/scripts/backfill-trades.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
}
