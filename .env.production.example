# Шаблон переменных для боевого окружения (Railway / Render / VPS).
# Локальный .env этим файлом не затрагивается.
#
# Заполняется в дашборде платформы, а не коммитится: здесь только структура
# и пояснения, реальные значения секретов в репозиторий попадать не должны.

# ─── Домены ──────────────────────────────────────────────────────────────
# Раскладка: фронтенд на корневом домене, API на поддомене.
# Так проще с сертификатами и не нужен reverse proxy.
#
#   memexdex.com       -> web  (Next.js)
#   api.memexdex.com   -> api  (Fastify)

NODE_ENV=production

# Источники, которым разрешено обращаться к API. Через запятую.
# Обязательно указать оба варианта: с www и без — иначе один из них
# будет молча заблокирован браузером.
CORS_ORIGINS=https://memexdex.com,https://www.memexdex.com

# Адрес API для фронтенда. Задаётся на этапе сборки образа веб-приложения
# (build arg NEXT_PUBLIC_API_URL), потому что Next вшивает его в бандл.
NEXT_PUBLIC_API_URL=https://api.memexdex.com/api/v1

# ─── Инфраструктура ──────────────────────────────────────────────────────
# Строка с -pooler в имени хоста — для рабочих запросов.
DATABASE_URL=
# Строка БЕЗ -pooler — только для миграций.
DIRECT_DATABASE_URL=
REDIS_URL=

API_PORT=4000

# ─── Секреты ─────────────────────────────────────────────────────────────
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=15m
REFRESH_TTL=30d

# ─── Режим исполнения ────────────────────────────────────────────────────
# paper — реальные котировки, транзакции в сеть не отправляются.
# live  — требует реализации подписи транзакций, депозитов, выводов и KMS.
#         Пока эти части не готовы, переключение только сломает исполнение.
EXECUTION_MODE=paper
FUNDING_ENABLED=false
LIVE_AGENT_ENABLED=false
LIVE_EXECUTION_ENABLED=false
WITHDRAWALS_ENABLED=false
LIVE_RPC_READY=false
LIVE_RECONCILIATION_ENABLED=false
LIVE_MIGRATIONS_READY=false
KMS_SIGNING_ENABLED=false
LIVE_AGENT_CONTROL_MODE=semi-auto

# ─── Хранение ключей ─────────────────────────────────────────────────────
# При EXECUTION_MODE=live значение local отвергается на старте:
# мастер-ключ в переменной окружения означает, что дамп окружения
# равен доступу ко всем средствам пользователей.
KMS_PROVIDER=local
KMS_LOCAL_MASTER_KEY=
AWS_KMS_KEY_ID=
HOT_WALLET_MAX_USD=25000

# ─── Сети ────────────────────────────────────────────────────────────────
# Публичные RPC на проде не годятся: лимит запросов и задержки превращаются
# в проскальзывание. Возьмите платный узел (Helius, QuickNode, Alchemy).
SOLANA_RPC_URL=
BNB_RPC_URL=
RHC_RPC_URL=
RHC_CHAIN_ID=

# ─── Агрегаторы ──────────────────────────────────────────────────────────
# AI-разбор токенов. Необязательно: без ключа собираются только факты
# из бесплатных источников (GoPlus, GeckoTerminal), без трактовки модели.
# Ключ: https://aistudio.google.com/apikey — бесплатный тариф ~250-1000
# запросов в сутки на моделях Flash.
# Радар новых токенов. Официальный Web3 API OKX (бесплатная регистрация
# в Developer Portal). Без ключей радар работает на GeckoTerminal.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_PROJECT_ID=
OKX_WS_ENABLED=true
OKX_SIGNAL_REST_FALLBACK_INTERVAL_MS=60000

# Уведомления радара в Telegram. Токен бота у @BotFather.
TELEGRAM_BOT_TOKEN=
# Paper-уведомления автономного агента администратору. По умолчанию выключены.
TELEGRAM_AGENT_NOTIFICATIONS_ENABLED=false
TELEGRAM_AGENT_CHAT_ID=

# Ниже этого порога ликвидности радар молчит вообще
RADAR_MIN_LIQUIDITY_USD=20000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

JUPITER_API_URL=https://quote-api.jup.ag/v6
ZEROX_API_URL=https://api.0x.org
ZEROX_API_KEY=

# ─── Экономика ───────────────────────────────────────────────────────────
PERFORMANCE_FEE_BPS=1000
PLATFORM_SWAP_FEE_BPS=0

# ─── Риск-лимиты ─────────────────────────────────────────────────────────
MAX_SLIPPAGE_BPS=300
MIN_LIQUIDITY_USD=15000
COPY_MAX_ALLOCATION_PCT=25

# ─── Почта ───────────────────────────────────────────────────────────────
# В production допустимы disabled, resend и smtp.
# EMAIL_PROVIDER=console приложение отвергает при старте: этот транспорт
# пишет письмо в журнал, то есть пользователь код никогда не получит.
#
# EMAIL_PROVIDER=resend требует и RESEND_API_KEY, и EMAIL_FROM —
# проверяется при старте, чтобы приложение не обещало отправку,
# которую не может выполнить.
EMAIL_PROVIDER=resend
# Домен обязан быть подтверждён в панели Resend (SPF, DKIM, DMARC),
# иначе провайдер отвергает письма, а не складывает их в спам.
EMAIL_FROM=Memex DEX <no-reply@ваш-домен>
# Секрет. Значение здесь не хранится — задаётся в переменных окружения
# площадки развёртывания.
RESEND_API_KEY=
# Альтернатива Resend для небольшого запуска через Gmail или другой SMTP.
# Секрет SMTP_PASS задаётся только в панели хостинга.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
PUBLIC_APP_NAME=Memex DEX
PUBLIC_APP_URL=https://ваш-домен

# ─── Оплата подписок (Bridge) ────────────────────────────────────────────
# При BRIDGE_PAYMENTS_ENABLED=true приложение не стартует без API-ключа,
# открытого ключа вебхука и корректного адреса Solana: без них платёж
# некуда доставить и нечем подтвердить.
BRIDGE_PAYMENTS_ENABLED=false
# Секреты здесь не хранятся — задаются в переменных окружения площадки.
BRIDGE_API_KEY=
BRIDGE_API_BASE_URL=https://api.bridge.xyz/v0
BRIDGE_WEBHOOK_PUBLIC_KEY=
# Адрес проверяется по форме при старте. Опечатка означает выручку,
# ушедшую в никуда без возможности вернуть.
SUBSCRIPTION_TREASURY_SOLANA_ADDRESS=
BRIDGE_WEBHOOK_MAX_AGE_SECONDS=600

# ─── Выбор платёжного провайдера ─────────────────────────────────────────
# disabled | bridge | coinbase. Приложение не стартует, если выбранный
# провайдер не включён своим флагом: расхождение между «выбран»
# и «настроен» означало бы страницу оплаты, за которой ничего нет.
SUBSCRIPTION_PAYMENT_PROVIDER=disabled

# ─── Оплата подписок (Coinbase Onramp) ───────────────────────────────────
# При COINBASE_ONRAMP_ENABLED=true приложение не стартует без ключа CDP,
# секрета вебхука, адреса возврата и адреса выручки.
#
# В production дополнительно запрещены: режим песочницы, адрес возврата
# по http, адрес возврата на localhost или на домен песочницы,
# и ключ с признаками тестового.
COINBASE_ONRAMP_ENABLED=false
COINBASE_ONRAMP_MODE=production
# Секреты здесь не хранятся — задаются в переменных окружения площадки.
COINBASE_CDP_API_KEY_ID=
COINBASE_CDP_API_KEY_SECRET=
COINBASE_WEBHOOK_SECRET=
COINBASE_REDIRECT_URL=https://ваш-домен/checkout
COINBASE_WEBHOOK_MAX_AGE_SECONDS=300
COINBASE_SANDBOX_CLIENT_IP=192.0.2.1
