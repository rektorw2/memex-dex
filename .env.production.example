# Шаблон переменных для боевого окружения (Railway / Render / VPS).
# Локальный .env этим файлом не затрагивается.
#
# Заполняется в дашборде платформы, а не коммитится: здесь только структура
# и пояснения, реальные значения секретов в репозиторий попадать не должны.

# ─── Домены ──────────────────────────────────────────────────────────────
# Раскладка: фронтенд на корневом домене, API на поддомене.
# Так проще с сертификатами и не нужен reverse proxy.
#
#   memexdex.com       -> web  (Next.js)
#   api.memexdex.com   -> api  (Fastify)

NODE_ENV=production

# Источники, которым разрешено обращаться к API. Через запятую.
# Обязательно указать оба варианта: с www и без — иначе один из них
# будет молча заблокирован браузером.
CORS_ORIGINS=https://memexdex.com,https://www.memexdex.com

# Адрес API для фронтенда. Задаётся на этапе сборки образа веб-приложения
# (build arg NEXT_PUBLIC_API_URL), потому что Next вшивает его в бандл.
NEXT_PUBLIC_API_URL=https://api.memexdex.com/api/v1

# ─── Инфраструктура ──────────────────────────────────────────────────────
# Строка с -pooler в имени хоста — для рабочих запросов.
DATABASE_URL=
# Строка БЕЗ -pooler — только для миграций.
DIRECT_DATABASE_URL=
REDIS_URL=

API_PORT=4000

# ─── Секреты ─────────────────────────────────────────────────────────────
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=15m
REFRESH_TTL=30d

# ─── Режим исполнения ────────────────────────────────────────────────────
# paper — реальные котировки, транзакции в сеть не отправляются.
# live  — требует реализации подписи транзакций, депозитов, выводов и KMS.
#         Пока эти части не готовы, переключение только сломает исполнение.
EXECUTION_MODE=paper

# ─── Хранение ключей ─────────────────────────────────────────────────────
# При EXECUTION_MODE=live значение local отвергается на старте:
# мастер-ключ в переменной окружения означает, что дамп окружения
# равен доступу ко всем средствам пользователей.
KMS_PROVIDER=local
KMS_LOCAL_MASTER_KEY=
AWS_KMS_KEY_ID=
HOT_WALLET_MAX_USD=25000

# ─── Сети ────────────────────────────────────────────────────────────────
# Публичные RPC на проде не годятся: лимит запросов и задержки превращаются
# в проскальзывание. Возьмите платный узел (Helius, QuickNode, Alchemy).
SOLANA_RPC_URL=
BNB_RPC_URL=
RHC_RPC_URL=
RHC_CHAIN_ID=

# ─── Агрегаторы ──────────────────────────────────────────────────────────
JUPITER_API_URL=https://quote-api.jup.ag/v6
ZEROX_API_URL=https://api.0x.org
ZEROX_API_KEY=

# ─── Экономика ───────────────────────────────────────────────────────────
PERFORMANCE_FEE_BPS=1000
PLATFORM_SWAP_FEE_BPS=0

# ─── Риск-лимиты ─────────────────────────────────────────────────────────
MAX_SLIPPAGE_BPS=300
MIN_LIQUIDITY_USD=15000
COPY_MAX_ALLOCATION_PCT=25
