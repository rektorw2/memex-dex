// Memex DEX — схема данных кастодиальной торговой платформы
// Денежные величины: Decimal(38, 18) для количеств токенов, Decimal(24, 8) для USD.
// Никогда не использовать Float для денег.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// О подключении к облачной базе (Neon и подобные).
//
// Рабочие запросы приложения должны идти через пул соединений — у Neon
// это хост с -pooler. Без пула бесплатный тариф упирается в лимит прямых
// подключений и API начинает получать «too many connections».
//
// Миграции, наоборот, нужно выполнять в обход пула: pgbouncer
// в transaction-режиме не поддерживает advisory locks и prepared
// statements, на которых держится механизм миграций Prisma.
//
// Директива directUrl здесь сознательно не используется: Prisma требует
// её переменную окружения безусловно, и локальный запуск без облачной
// базы падал бы с ошибкой P1012. Вместо этого нужная строка передаётся
// самой команде:
//
//   DATABASE_URL="<строка без -pooler>" npm run db:push
//
// На Render то же самое сделано в preDeployCommand (см. render.yaml).

// ─────────────────────────────── Пользователи ───────────────────────────────

enum UserRole {
  USER
  TRADER // лидер копитрейдинга
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  totpSecret   String? // 2FA, обязателен для вывода средств
  role         UserRole @default(USER)

  /**
   * Когда подтверждён адрес почты.
   * Не булево поле: «когда» отвечает и на вопрос «подтверждена ли»,
   * и на вопрос «когда именно», а второй понадобится при разборе
   * попыток получить бесплатный период по чужому адресу.
   * От него зависит выдача пробного периода. Без подтверждения
   * правило «один раз на пользователя» превратилось бы в «один раз
   * на адрес, который не надо подтверждать», то есть ни во что.
   */
  emailVerifiedAt DateTime?

  /**
   * Код подтверждения почты: хеш, срок и число попыток.
   * Сам код не хранится. Утечка базы не должна давать возможность
   * подтвердить чужой адрес — а именно это она и означала бы,
   * лежи там шесть цифр открытым текстом.
   * Три поля вместо отдельной таблицы: код у пользователя всегда
   * один, живёт пятнадцать минут и переживает разве что перезагрузку
   * страницы. Таблица со своей жизнью здесь была бы дороже пользы.
   */
  emailCodeHash     String?
  emailCodeIssuedAt DateTime?
  emailCodeExpires  DateTime?
  emailCodeAttempts Int       @default(0)

  /**
   * Чат Telegram для уведомлений радара. Привязывается кодом из бота.
   */
  telegramChatId   String?
  telegramLinkCode String?   @unique
  kycStatus        KycStatus @default(NONE)
  kycRef           String? // id провайдера (Sumsub/Persona)
  isFrozen         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  wallets         Wallet[]
  balances        Balance[]
  orders          Order[]
  trades          Trade[]
  positions       Position[]
  withdrawals     Withdrawal[]
  feeEntries      FeeLedger[]
  subscriptions   CopySubscription[]  @relation("follower")
  followers       CopySubscription[]  @relation("leader")
  calls           Call[]
  sessions        Session[]
  auditLogs       AuditLog[]
  radarSubs       RadarSubscription[]
  apiKeys         ApiKey[]
  walletFavorites WalletFavorite[]

  /**
   * Оплаченные планы.
   * Имя не `subscriptions`: оно уже занято подписками копитрейдинга,
   * и это не совпадение, а два разных смысла одного слова. Там —
   * «повторять за этим человеком», здесь — «оплачено до такого-то
   * числа». Одно имя на оба однажды приведёт к тому, что отмена
   * оплаты остановит копирование или наоборот.
   * Колонки `plan` в User нет намеренно. План — не свойство человека,
   * а срочный договор с началом, концом и историей. Колонка хранила бы
   * только последнее значение: на вопрос «что у него было в прошлый
   * вторник» ответить стало бы нечем, а именно этот вопрос задают,
   * когда разбираются со спорным списанием.
   */
  planSubscriptions Subscription[]

  /**
   * Связь с платёжным провайдером и оплаты подписок.
   */
  paymentCustomers     PaymentCustomer[]
  subscriptionPayments SubscriptionPayment[]

  @@index([role])
}

/**
 * Кошелёк в избранном у пользователя.
 * Отдельно от CopySubscription намеренно. Та связывает пользователя
 * с пользователем ради повторения сделок — это отношение с деньгами
 * и рисками. Здесь другое: наблюдение за чужим адресом в сети,
 * никакой связи с аккаунтом владельца адреса нет и быть не может.
 * Слить их в одну таблицу значило бы получить сущность, у которой
 * половина полей всегда пуста, и обе стороны отношения означают
 * разное в зависимости от строки.
 * Ключ — сеть плюс нормализованный адрес. Один и тот же набор
 * символов в Ethereum и в BNB Chain принадлежит разным владельцам;
 * считать их одним кошельком значит показывать человеку чужую
 * историю сделок под видом его наблюдения.
 */
model WalletFavorite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chain         Chain
  /**
   * Адрес в нормальной форме.
   * Для EVM — в нижнем регистре, для Solana — как есть: там регистр
   * значим, и приведение сделало бы адрес другим. Нормализация
   * выполняется до записи, потому что уникальность проверяет база,
   * а она сравнивает строки побайтово.
   */
  walletAddress String

  /**
   * Заметка пользователя. Не показывается никому, кроме него.
   */
  note String?

  createdAt DateTime @default(now())

  @@unique([userId, chain, walletAddress])
  @@index([userId, createdAt])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────── Сети и токены ──────────────────────────────

enum Chain {
  SOLANA
  BNB
  ROBINHOOD // Robinhood Chain — Arbitrum Orbit L2, EVM-совместим
  ETHEREUM
  BASE
}

model Token {
  id         String  @id @default(cuid())
  chain      Chain
  address    String // mint для Solana, contract для EVM
  symbol     String
  name       String
  decimals   Int
  logoUrl    String?
  isQuote    Boolean @default(false) // USDC/SOL/BNB — валюты котировки
  isVerified Boolean @default(false)

  // Адрес основного пула ликвидности. Нужен для запроса свечей:
  // OHLCV существует у пары, а не у токена — у одного токена может быть
  // десяток пулов с разной ценой, и брать надо самый ликвидный.
  poolAddress String?
  /**
   * Источник появления в списке: auto — импортёр, manual — админ.
   */
  source      String? @default("manual")
  /**
   * Скрыт из витрины вручную, при этом остаётся в истории сделок.
   */
  isHidden    Boolean @default(false)

  // Риск-метрики, обновляются воркером
  liquidityUsd   Decimal?  @db.Decimal(24, 8)
  volume24hUsd   Decimal?  @db.Decimal(24, 8)
  priceUsd       Decimal?  @db.Decimal(38, 18)
  /**
   * Когда цена получена от провайдера.
   * Не `updatedAt`: тот двигает любая запись в строку, включая
   * проверку контракта, и по нему нельзя отличить свежую котировку
   * от свежей строки. Без отдельного поля интерфейс не может ни
   * показать возраст цены, ни пометить её устаревшей, а воркер —
   * отличить горячий токен от холодного.
   * Пустое значение означает «цена ни разу не обновлялась после
   * импорта», и выдавать её за свежую нельзя.
   */
  priceUpdatedAt DateTime?
  priceChange24h Decimal?  @db.Decimal(12, 4)
  fdvUsd         Decimal?  @db.Decimal(24, 8)
  holders        Int?
  isHoneypot     Boolean   @default(false)
  lpBurnedPct    Decimal?  @db.Decimal(8, 4)
  topHolderPct   Decimal?  @db.Decimal(8, 4)
  riskScore      Int? // 0-100, чем выше — тем опаснее

  // ─── Допуск в терминал ──────────────────────────────────────────────
  // Отдельно от riskScore: тот отвечает «насколько опасно», этот —
  // «показывать ли вообще». Скор 78 ничего не говорит человеку,
  // который смотрит список из двухсот токенов.

  /**
   * BLOCK | WARN | OK. Оставлено для совместимости со старыми записями;
   * новая логика пишет riskLevel.
   */
  scamVerdict String?
  /**
   * Причины блокировки и поводы для осторожности.
   */
  scamReasons Json?

  /**
   * Уровень риска: verified | low | medium | high | blocked | pending.
   * Отдельно от scamVerdict, потому что различает больше состояний.
   * «Проверен и известен» и «ничего плохого не нашли» — разные
   * утверждения, и первое можно показывать без оговорок, второе нет.
   */
  riskLevel        String?
  /**
   * Машиночитаемые коды причин: HONEYPOT, FAKE_SYMBOL и прочие.
   */
  riskCodes        String[]
  /**
   * Токен есть в реестре подтверждённых адресов.
   */
  isRegistered     Boolean   @default(false)
  /**
   * Когда последний раз проверяли контракт и поведение пула.
   */
  scamCheckedAt    DateTime?
  /**
   * Версия правил, по которым выставлен вердикт.
   * Без неё изменение правил не влияло ни на что: у проверенного токена
   * стоит отметка времени, и следующая проверка откладывается на сутки —
   * даже если за это время появилось правило, которое его блокирует.
   * Именно так подделки под NVDA пережили добавление проверки на них.
   */
  scamRulesVersion Int       @default(0)

  /**
   * Неудачных попыток проверки подряд.
   * Хранится в базе, а не в памяти воркера: перезапуск обнулял бы
   * счётчик, и токен, который стабильно роняет проверку, начинал бы
   * круг заново после каждого деплоя. Именно такие записи и выедают
   * пропускную способность очереди, оставаясь незаметными.
   * Успешная проверка обнуляет счётчик.
   */
  scamCheckAttempts Int @default(0)

  /**
   * Раньше этого времени повторять нет смысла.
   * Экспоненциальная задержка с разбросом. Разброс обязателен: сотня
   * токенов, упавших на одном таймауте провайдера, без него повторит
   * запрос одновременно и уронит его снова — уже своими силами.
   */
  scamCheckNextAt DateTime?

  /**
   * Последняя попытка упёрлась в недоступность источников.
   * Отдельно от вердикта намеренно. Сбой сети — факт о сети, а не
   * о токене, и раньше он превращался в `blocked`: правило «ни один
   * источник не знает токен» не отличало пустой ответ от неответа.
   */
  scamProviderError Boolean @default(false)

  // Счётчики сделок из DexScreener: единственный признак ханипота,
  // видимый без вызова контракта.
  buys24h  Int?
  sells24h Int?
  /**
   * Ссылки на сайт и соцсети, если источник их отдал.
   */
  socials  Json?

  metricsUpdated DateTime?

  /**
   * Когда появился сам рынок, по данным провайдера.
   * Не путать с `createdAt`: тот отвечает на вопрос «когда мы завели
   * запись», а этот — «сколько лет торгуется токен». Разница
   * не косметическая: список «Новые» строился по `createdAt`
   * и показывал старые токены, импортированные сегодня, а на новизну
   * здесь покупают.
   * Может отсутствовать: не всякий провайдер сообщает время пула.
   * Неизвестный возраст не выдаётся за малый.
   */
  poolCreatedAt DateTime?

  /**
   * Когда мы впервые увидели токен на рынке.
   * Приближение возраста для случаев, где провайдер молчит о пуле.
   * Хуже `poolCreatedAt`, но честнее `createdAt`: запись могли
   * пересоздать, а первое наблюдение остаётся.
   */
  firstSeenAt DateTime?

  createdAt DateTime @default(now())

  balances   Balance[]
  ordersIn   Order[]        @relation("tokenIn")
  ordersOut  Order[]        @relation("tokenOut")
  positions  Position[]
  calls      Call[]
  candles    Candle[]
  research   TokenResearch?
  okxSignals OkxSignal[]

  @@unique([chain, address])
  @@index([chain, isVerified])
  @@index([volume24hUsd])
  @@index([scamVerdict, volume24hUsd])
  @@index([scamCheckedAt])
  @@index([scamRulesVersion])
  @@index([riskLevel, volume24hUsd])
  // Сортировка и отсечка по возрасту рынка идут вместе с фильтром
  // по скрытым: без индекса «Новые» превращались бы в полный проход.
  @@index([isHidden, poolCreatedAt])
  @@index([isHidden, firstSeenAt])
  // Очередь проверки отбирает по времени следующей попытки: без
  // индекса каждый проход читал бы всю витрину, чтобы отбросить
  // те записи, до которых ещё рано.
  @@index([scamCheckNextAt])
  // Холодный цикл цен идёт по возрасту котировки. Nulls first —
  // ни разу не обновлённые важнее всех остальных.
  @@index([isHidden, priceUpdatedAt])
}

/**
 * Одно событие официальной ленты OKX Signal.
 * Отдельно от Token: один токен появляется в Signal много раз, и
 * повторный вход Smart Money — новое событие, а не обновление названия
 * токена. История нужна и для порядка «новые сверху», и для измерения
 * результата от каждого момента сигнала.
 */
model OkxSignal {
  id          String @id @default(cuid())
  providerKey String @unique

  chain   Chain
  address String
  tokenId String?
  token   Token?  @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  symbol  String
  name    String
  logoUrl String?

  signaledAt DateTime
  receivedAt DateTime @default(now())

  priceUsd       Decimal?  @db.Decimal(38, 18)
  marketCapUsd   Decimal?  @db.Decimal(24, 8)
  // Максимальная наблюдавшаяся цена после этого конкретного сигнала.
  // Это не lifetime ATH токена: два сигнала одного токена имеют
  // разные точки отсчёта и независимо накапливают свой пик.
  peakPriceUsd   Decimal?  @db.Decimal(38, 18)
  peakObservedAt DateTime?
  holders        Int?
  top10HolderPct Decimal?  @db.Decimal(8, 4)

  walletTypes            String[]
  /**
   * Адреса кошельков-триггеров, если OKX прислал их в событии.
   */
  triggerWalletAddresses String[] @default([])
  triggerWalletCount     Int?
  amountUsd              Decimal? @db.Decimal(24, 8)
  soldRatioPct           Decimal? @db.Decimal(8, 4)
  source                 String
  /** Наиболее сильное подтверждённое происхождение ingest; NULL — legacy. */
  ingestOrigin           String?
  /** Результат фильтра до создания strategy runs. */
  paperAgentIngestCode   String?

  createdAt DateTime @default(now())

  paperAgentRuns PaperAgentRun[]

  @@index([signaledAt])
  @@index([chain, signaledAt])
  @@index([tokenId, signaledAt])
  @@index([chain, address, signaledAt])
  @@index([ingestOrigin, receivedAt])
  @@index([paperAgentIngestCode, receivedAt])
}

/**
 * Главный выключатель автономного агента.
 * Он управляет только симуляцией. Даже включённая строка не имеет силы,
 * если процесс запущен с EXECUTION_MODE != paper: это проверяется до старта
 * воркера и отдельным контрактным тестом.
 */
model PaperAgentControl {
  id                            String   @id @default("primary")
  isEnabled                     Boolean  @default(false)
  baselineStrategyKey           String   @default("okx-signal-v2-baseline")
  telegramShadowEnabled         Boolean  @default(false)
  /**
   * Phase 3 остаётся не настроенной, пока администратор явно не выберет режим.
   */
  activeAllocationMode          String?
  activeAllocationPolicyKey     String?
  activeAllocationPolicyVersion Int?
  learningModeEnabled           Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

/**
 * Неизменяемая версия baseline либо одного shadow-эксперимента.
 */
model PaperAgentStrategy {
  id        String   @id @default(cuid())
  key       String   @unique
  version   Int
  label     String
  kind      String
  isEnabled Boolean  @default(true)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs PaperAgentRun[]

  @@index([kind, isEnabled])
}

/**
 * Одно решение одной версии стратегии по одному событию OKX Signal.
 * Уникальность signal+strategy — защита и от повторного WS-события, и от
 * параллельной обработки, и от рестарта посередине перехода состояния.
 */
model PaperAgentRun {
  id         String             @id @default(cuid())
  signalId   String
  signal     OkxSignal          @relation(fields: [signalId], references: [id], onDelete: Cascade)
  strategyId String
  strategy   PaperAgentStrategy @relation(fields: [strategyId], references: [id], onDelete: Restrict)

  providerKey String
  tokenId     String?
  chain       Chain
  address     String
  symbol      String
  source      String

  state        String
  decisionCode String?
  errorCode    String?

  signaledAt DateTime
  receivedAt DateTime
  decidedAt  DateTime?
  latencyMs  Int?
  /** Новые именованные метрики; NULL безопасен для исторических строк. */
  signalOrigin                String?
  providerDeliveryLatencyMs   Int?
  agentDecisionLatencyMs      Int?
  endToEndLatencyMs           Int?

  poolCreatedAt          DateTime?
  tokenAgeMs             Int?
  walletTypes            String[]
  triggerWalletAddresses String[]  @default([])
  signalAmountUsd        Decimal?  @db.Decimal(24, 8)
  signalPriceUsd         Decimal?  @db.Decimal(38, 18)
  signalMarketCapUsd     Decimal?  @db.Decimal(24, 8)
  decisionPriceUsd       Decimal?  @db.Decimal(38, 18)
  priceSource            String?
  warnings               Json?

  positionUsd            Decimal?  @db.Decimal(24, 8)
  costModelKey           String?
  tradeFeeBps            Int?
  entrySlippageBps       Int?
  exitSlippageBps        Int?
  networkFeeUsdPerSide   Decimal?  @db.Decimal(24, 8)
  feeBps                 Int?
  slippageBps            Int?
  entryAt                DateTime?
  entrySourcePriceUsd    Decimal?  @db.Decimal(38, 18)
  entryExecutionPriceUsd Decimal?  @db.Decimal(38, 18)
  entryQuantity          Decimal?  @db.Decimal(38, 18)
  entryTradingFeeUsd     Decimal?  @db.Decimal(24, 8)
  entryNetworkFeeUsd     Decimal?  @db.Decimal(24, 8)
  entrySlippageUsd       Decimal?  @db.Decimal(24, 8)
  entryFeeUsd            Decimal?  @db.Decimal(24, 8)
  targetSourcePriceUsd   Decimal?  @db.Decimal(38, 18)

  currentSourcePriceUsd    Decimal?  @db.Decimal(38, 18)
  currentExecutionPriceUsd Decimal?  @db.Decimal(38, 18)
  unrealizedPnlUsd         Decimal?  @db.Decimal(24, 8)
  peakSourcePriceUsd       Decimal?  @db.Decimal(38, 18)
  maxMultiple              Decimal?  @db.Decimal(18, 8)
  maxDrawdownPct           Decimal?  @db.Decimal(12, 6)
  lastMarkedAt             DateTime?

  exitAt                DateTime?
  exitReason            String?
  exitSourcePriceUsd    Decimal?  @db.Decimal(38, 18)
  exitExecutionPriceUsd Decimal?  @db.Decimal(38, 18)
  exitTradingFeeUsd     Decimal?  @db.Decimal(24, 8)
  exitNetworkFeeUsd     Decimal?  @db.Decimal(24, 8)
  exitSlippageUsd       Decimal?  @db.Decimal(24, 8)
  exitFeeUsd            Decimal?  @db.Decimal(24, 8)
  totalCostsUsd         Decimal?  @db.Decimal(24, 8)
  grossExitUsd          Decimal?  @db.Decimal(24, 8)
  netExitUsd            Decimal?  @db.Decimal(24, 8)
  realizedPnlUsd        Decimal?  @db.Decimal(24, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications PaperAgentNotification[]
  allocations   PaperAgentAllocation[]

  @@unique([signalId, strategyId])
  @@index([state, updatedAt])
  @@index([strategyId, createdAt])
  @@index([tokenId, state])
  @@index([providerKey])
  @@index([signalOrigin, createdAt])
}

/**
 * Transactional outbox и одновременно сохранённое in-app уведомление.
 * Секретов транспорта здесь нет: только безопасный payload и состояние доставки.
 */
model PaperAgentNotification {
  id       String         @id @default(cuid())
  eventKey String         @unique
  runId    String?
  run      PaperAgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  eventType       String
  strategyKey     String?
  strategyVersion Int?
  isBaselineEvent Boolean @default(false)
  payload         Json

  inAppStatus      String    @default("PENDING")
  inAppDeliveredAt DateTime?
  isRead           Boolean   @default(false)
  readAt           DateTime?

  telegramEligible      Boolean   @default(false)
  telegramStatus        String    @default("DISABLED")
  telegramAttempts      Int       @default(0)
  telegramNextAttemptAt DateTime?
  telegramLastAttemptAt DateTime?
  telegramDeliveredAt   DateTime?
  telegramErrorCode     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inAppStatus, createdAt])
  @@index([isRead, createdAt])
  @@index([telegramStatus, telegramNextAttemptAt])
  @@index([strategyKey, eventType, createdAt])
  @@index([runId, createdAt])
}

/**
 * Неизменяемая версия политики распределения PAPER-капитала.
 * Новая версия создаётся отдельной строкой; существующая не переписывается.
 */
model PaperAgentAllocationPolicy {
  id          String  @id @default(cuid())
  policyKey   String
  version     Int
  mode        String
  riskProfile String?
  label       String
  limits      Json

  scorePolicyKey     String
  scorePolicyVersion Int

  status            String    @default("SYSTEM")
  source            String    @default("SYSTEM")
  hypothesisMetrics Json?
  sampleSize        Int?
  periodStart       DateTime?
  periodEnd         DateTime?
  reviewedAt        DateTime?
  reviewedBy        String?
  promotedAt        DateTime?

  createdAt DateTime @default(now())

  @@unique([policyKey, version])
  @@index([mode, status])
  @@index([status, createdAt])
}

/**
 * Отдельный капиталовый контур. ACTIVE и SHADOW не делят баланс и лимиты:
 * эксперимент не может съесть слот или резерв рабочего режима.
 */
model PaperAgentAccountSession {
  id                 String  @id @default(cuid())
  kind               String
  mode               String
  status             String  @default("ACTIVE")
  policyKey          String
  policyVersion      Int
  riskProfile        String?
  policySnapshot     Json
  scorePolicyKey     String
  scorePolicyVersion Int

  reservePct             Decimal @db.Decimal(8, 4)
  maxExposurePct         Decimal @db.Decimal(8, 4)
  maxPositionPct         Decimal @db.Decimal(8, 4)
  maxOpenPositions       Int
  minimumPositionUsd     Decimal @db.Decimal(24, 8)
  dailyEntryLimit        Int
  drawdownStopPct        Decimal @db.Decimal(8, 4)
  allowPartialAllocation Boolean

  initialCapitalUsd  Decimal  @db.Decimal(24, 8)
  freeBalanceUsd     Decimal  @db.Decimal(24, 8)
  reservedBalanceUsd Decimal  @db.Decimal(24, 8)
  inPositionsUsd     Decimal  @db.Decimal(24, 8)
  realizedPnlUsd     Decimal  @db.Decimal(24, 8)
  unrealizedPnlUsd   Decimal  @db.Decimal(24, 8)
  tradingFeesUsd     Decimal  @db.Decimal(24, 8)
  slippageUsd        Decimal  @db.Decimal(24, 8)
  networkCostsUsd    Decimal  @db.Decimal(24, 8)
  equityUsd          Decimal  @db.Decimal(24, 8)
  peakEquityUsd      Decimal  @db.Decimal(24, 8)
  drawdownPct        Decimal  @db.Decimal(12, 6)
  openPositions      Int      @default(0)
  dailyEntries       Int      @default(0)
  dailyEntriesDate   DateTime
  ledgerVersion      Int      @default(0)
  lastRecalculatedAt DateTime @default(now())

  resetFromId String?
  resetFrom   PaperAgentAccountSession?  @relation("PaperAgentSessionReset", fields: [resetFromId], references: [id], onDelete: SetNull)
  resets      PaperAgentAccountSession[] @relation("PaperAgentSessionReset")

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  allocations PaperAgentAllocation[]
  ledger      PaperAgentCapitalLedger[]

  @@index([kind, status])
  @@index([mode, status])
  @@index([policyKey, policyVersion])
  @@index([resetFromId])
}

/**
 * Одно решение одного капиталового контура по одному Phase 1/2 run.
 */
model PaperAgentAllocation {
  id        String                   @id @default(cuid())
  sessionId String
  session   PaperAgentAccountSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  runId     String
  run       PaperAgentRun            @relation(fields: [runId], references: [id], onDelete: Cascade)

  isShadow         Boolean
  state            String
  decisionCode     String
  mode             String
  policyKey        String
  policyVersion    Int
  riskProfile      String?
  policySnapshot   Json
  inputFacts       Json
  signalScore      Int
  signalBand       String
  allocationReason String

  allocatedUsd     Decimal? @db.Decimal(24, 8)
  capitalPct       Decimal? @db.Decimal(12, 6)
  freeAfterUsd     Decimal  @db.Decimal(24, 8)
  reserveAfterUsd  Decimal  @db.Decimal(24, 8)
  exposureAfterUsd Decimal  @db.Decimal(24, 8)

  entryAt                DateTime?
  entrySourcePriceUsd    Decimal?  @db.Decimal(38, 18)
  entryExecutionPriceUsd Decimal?  @db.Decimal(38, 18)
  entryQuantity          Decimal?  @db.Decimal(38, 18)
  targetSourcePriceUsd   Decimal?  @db.Decimal(38, 18)

  currentSourcePriceUsd Decimal?  @db.Decimal(38, 18)
  unrealizedPnlUsd      Decimal?  @db.Decimal(24, 8)
  peakSourcePriceUsd    Decimal?  @db.Decimal(38, 18)
  maxMultiple           Decimal?  @db.Decimal(18, 8)
  maxDrawdownPct        Decimal?  @db.Decimal(12, 6)
  lastMarkedAt          DateTime?

  exitAt                DateTime?
  exitReason            String?
  exitSourcePriceUsd    Decimal?  @db.Decimal(38, 18)
  exitExecutionPriceUsd Decimal?  @db.Decimal(38, 18)
  grossExitUsd          Decimal?  @db.Decimal(24, 8)
  netExitUsd            Decimal?  @db.Decimal(24, 8)
  realizedPnlUsd        Decimal?  @db.Decimal(24, 8)
  tradingFeesUsd        Decimal?  @db.Decimal(24, 8)
  slippageUsd           Decimal?  @db.Decimal(24, 8)
  networkCostsUsd       Decimal?  @db.Decimal(24, 8)
  totalCostsUsd         Decimal?  @db.Decimal(24, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger PaperAgentCapitalLedger[]

  @@unique([runId, sessionId])
  @@index([sessionId, state])
  @@index([state, updatedAt])
  @@index([runId])
}

/**
 * Неизменяемая проводка со снимками до/после атомарного изменения капитала.
 */
model PaperAgentCapitalLedger {
  id           String                   @id @default(cuid())
  eventKey     String                   @unique
  sessionId    String
  session      PaperAgentAccountSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  allocationId String?
  allocation   PaperAgentAllocation?    @relation(fields: [allocationId], references: [id], onDelete: SetNull)

  eventType String
  amountUsd Decimal @db.Decimal(24, 8)

  freeBeforeUsd        Decimal @db.Decimal(24, 8)
  freeAfterUsd         Decimal @db.Decimal(24, 8)
  reservedBeforeUsd    Decimal @db.Decimal(24, 8)
  reservedAfterUsd     Decimal @db.Decimal(24, 8)
  inPositionsBeforeUsd Decimal @db.Decimal(24, 8)
  inPositionsAfterUsd  Decimal @db.Decimal(24, 8)
  realizedPnlAfterUsd  Decimal @db.Decimal(24, 8)
  equityAfterUsd       Decimal @db.Decimal(24, 8)
  tradingFeesAfterUsd  Decimal @db.Decimal(24, 8)
  slippageAfterUsd     Decimal @db.Decimal(24, 8)
  networkCostsAfterUsd Decimal @db.Decimal(24, 8)
  metadata             Json?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([allocationId, createdAt])
  @@index([eventType, createdAt])
}

model Candle {
  id        String   @id @default(cuid())
  tokenId   String
  token     Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  interval  String // 1m 5m 15m 1h 4h 1d
  openTime  DateTime
  open      Decimal  @db.Decimal(38, 18)
  high      Decimal  @db.Decimal(38, 18)
  low       Decimal  @db.Decimal(38, 18)
  close     Decimal  @db.Decimal(38, 18)
  volumeUsd Decimal  @db.Decimal(24, 8)

  @@unique([tokenId, interval, openTime])
  @@index([tokenId, interval, openTime])
}

// ────────────────────────── Кастодиальные кошельки ──────────────────────────

enum WalletKind {
  HOT_DEPOSIT // персональный адрес депозита пользователя
  HOT_TRADING // общий торговый кошелёк (omnibus)
  COLD // холодное хранение, ключ вне системы
  FEE_COLLECTOR
}

model Wallet {
  id      String     @id @default(cuid())
  userId  String?
  user    User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  chain   Chain
  kind    WalletKind
  address String

  // Приватный ключ НИКОГДА не хранится в открытом виде.
  // Envelope encryption: DEK шифрует ключ, KMS шифрует DEK.
  encryptedKey   Bytes? // AES-256-GCM ciphertext
  keyNonce       Bytes?
  keyAuthTag     Bytes?
  wrappedDek     Bytes? // DEK, зашифрованный мастер-ключом KMS
  kmsKeyId       String?
  derivationPath String? // если HD-кошелёк
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())

  deposits Deposit[]

  @@unique([chain, address])
  @@index([userId])
}

// ────────────────────────────── Баланс и учёт ───────────────────────────────
// Двойная запись: Balance — это агрегат, LedgerEntry — источник истины.

model Balance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenId   String
  token     Token    @relation(fields: [tokenId], references: [id])
  available Decimal  @default(0) @db.Decimal(38, 18)
  locked    Decimal  @default(0) @db.Decimal(38, 18) // зарезервировано под лимитки
  updatedAt DateTime @updatedAt
  version   Int      @default(0) // оптимистичная блокировка

  @@unique([userId, tokenId])
  @@index([userId])
}

enum LedgerType {
  DEPOSIT
  WITHDRAWAL
  TRADE_IN
  TRADE_OUT
  FEE_PERFORMANCE
  FEE_SWAP
  FEE_NETWORK
  LOCK
  UNLOCK
  ADJUSTMENT
}

model LedgerEntry {
  id        String     @id @default(cuid())
  userId    String
  tokenId   String
  type      LedgerType
  amount    Decimal    @db.Decimal(38, 18) // знаковая: + приход, - расход
  refType   String? // Trade | Order | Withdrawal | Deposit | FeeLedger
  refId     String?
  memo      String?
  createdAt DateTime   @default(now())

  @@index([userId, tokenId, createdAt])
  @@index([refType, refId])
}

// ───────────────────────────── Ордера и сделки ──────────────────────────────

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP_LOSS
  TAKE_PROFIT
  TRAILING_STOP
}

enum OrderStatus {
  PENDING // создан, ждёт резерва средств
  OPEN // активен (лимитка в книге)
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
  EXPIRED
}

enum OrderSource {
  MANUAL
  COPY_TRADE
  CALL // клик по коллу админа
  API
}

model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain  Chain

  tokenInId  String
  tokenIn    Token  @relation("tokenIn", fields: [tokenInId], references: [id])
  tokenOutId String
  tokenOut   Token  @relation("tokenOut", fields: [tokenOutId], references: [id])

  side   OrderSide
  type   OrderType
  status OrderStatus @default(PENDING)
  source OrderSource @default(MANUAL)

  amountIn     Decimal   @db.Decimal(38, 18) // сколько отдаём
  filledIn     Decimal   @default(0) @db.Decimal(38, 18)
  filledOut    Decimal   @default(0) @db.Decimal(38, 18)
  // Обе цены — в долларах за торгуемый токен, а не в единицах tokenIn.
  // Именно так их шлёт интерфейс и так сравнивает воркер отложенных
  // ордеров: он берёт token.priceUsd и сопоставляет напрямую.
  limitPrice   Decimal?  @db.Decimal(38, 18)
  triggerPrice Decimal?  @db.Decimal(38, 18) // цена срабатывания стопа/тейка, USD
  trailingBps  Int? // для trailing stop
  slippageBps  Int       @default(100)
  expiresAt    DateTime?

  // связь с копитрейдингом
  parentOrderId String?
  parentOrder   Order?  @relation("copyChildren", fields: [parentOrderId], references: [id])
  children      Order[] @relation("copyChildren")
  callId        String?
  call          Call?   @relation(fields: [callId], references: [id])

  rejectReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trades Trade[]

  @@index([userId, status])
  @@index([status, type]) // воркер лимиток
  @@index([parentOrderId])
}

enum TradeStatus {
  SUBMITTED
  CONFIRMED
  FAILED
}

model Trade {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chain     Chain
  amountIn  Decimal @db.Decimal(38, 18)
  amountOut Decimal @db.Decimal(38, 18)
  price     Decimal @db.Decimal(38, 18) // исполненная цена out в in
  priceUsd  Decimal @db.Decimal(38, 18) // цена торгуемого токена в USD на момент сделки
  valueUsd  Decimal @db.Decimal(24, 8)

  // исполнение
  route          Json? // маршрут агрегатора
  aggregator     String? // jupiter | 0x | odos
  txSignature    String?  @unique
  blockNumber    BigInt?
  networkFeeUsd  Decimal? @db.Decimal(24, 8)
  slippageBps    Int?
  priceImpactBps Int?

  // комиссии
  swapFeeUsd        Decimal @default(0) @db.Decimal(24, 8)
  performanceFeeUsd Decimal @default(0) @db.Decimal(24, 8)
  realizedPnlUsd    Decimal @default(0) @db.Decimal(24, 8) // только для SELL

  status      TradeStatus @default(SUBMITTED)
  error       String?
  createdAt   DateTime    @default(now())
  confirmedAt DateTime?

  fees FeeLedger[]

  @@index([userId, createdAt])
  @@index([status])
}

// ─────────────────────────── Позиции (учёт PnL) ─────────────────────────────

model Position {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id])

  quantity       Decimal @default(0) @db.Decimal(38, 18)
  avgCostUsd     Decimal @default(0) @db.Decimal(38, 18) // средневзвешенная цена входа
  costBasisUsd   Decimal @default(0) @db.Decimal(24, 8)
  realizedPnlUsd Decimal @default(0) @db.Decimal(24, 8)
  feesPaidUsd    Decimal @default(0) @db.Decimal(24, 8)

  // источник позиции — важно: performance fee берётся только с копитрейд-объёма
  copiedQuantity Decimal @default(0) @db.Decimal(38, 18)

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([userId, tokenId])
  @@index([userId])
}

// ────────────────────── Исследование токена (факты + AI) ────────────────────

/**
 * Результат разбора токена: проверяемые факты из открытых источников
 * и отдельно — трактовка модели.
 * Эти две части сознательно не смешиваются. Факт «активен mint authority»
 * проверяем и воспроизводим; вывод «команда выглядит анонимной» — суждение,
 * которое может быть ошибочным. Пользователь должен видеть, где что.
 */
model TokenResearch {
  id      String @id @default(cuid())
  tokenId String @unique
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  // ─── Проверяемые факты ───────────────────────────────────────────────
  /**
   * /** Ответ сканера безопасности: mint/freeze authority, налоги, ханипот.
   */
  securityFlags Json?
  /**
   * Ссылки на соцсети и сайт проекта, найденные в открытых источниках.
   */
  socials       Json?
  /**
   * Распределение по держателям: топ-10, доля создателя, число адресов.
   */
  holderStats   Json?
  /**
   * Источники фактов: имя сервиса и время получения.
   */
  factSources   Json?

  // ─── Трактовка модели ────────────────────────────────────────────────
  aiSummary     String? @db.Text
  /**
   * Репутационный риск 0-100. Отдельно от технического riskScore токена.
   */
  aiRiskScore   Int?
  aiRiskFactors Json?
  /**
   * positive | neutral | negative | unknown
   */
  aiSentiment   String?
  /**
   * Ссылки, на которые опиралась модель.
   */
  aiSources     Json?
  aiModel       String?

  /**
   * ok — всё собрано, partial — часть источников недоступна, failed — нет данных.
   */
  status    String   @default("ok")
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// ──────────────────────────── Радар новых токенов ───────────────────────────

/**
 * Обнаруженный новый токен.
 * Отдельная таблица, а не флаг у Token: радар видит гораздо больше, чем
 * попадает в витрину. Большинство новых пулов — мусор, который не должен
 * засорять список торгуемых токенов, но должен остаться в истории, чтобы
 * не уведомлять об одном и том же дважды.
 */
model RadarEvent {
  id      String @id @default(cuid())
  chain   Chain
  address String
  symbol  String
  name    String

  poolAddress  String?
  priceUsd     Decimal? @db.Decimal(38, 18)
  liquidityUsd Decimal? @db.Decimal(24, 8)
  volume24hUsd Decimal? @db.Decimal(24, 8)
  fdvUsd       Decimal? @db.Decimal(24, 8)
  /**
   * Возраст пула на момент обнаружения, часы.
   */
  poolAgeHours Decimal? @db.Decimal(12, 4)

  /**
   * Кто нашёл: okx | geckoterminal.
   */
  source    String
  riskScore Int?
  riskFlags Json?

  /**
   * Уровень и коды причин из того же движка, что у терминала.
   * До этого радар считал риск отдельно — по ликвидности, объёму
   * и возрасту пула, — и один токен мог быть «низкий риск» в радаре
   * и «заблокирован» в терминале. Для человека это выглядит как
   * поломка, и справедливо: два раздела одного продукта не могут
   * расходиться в том, опасен токен или нет.
   * riskFlags оставлены для старых записей, но новые пишут сюда.
   */
  riskLevel        String?
  riskCodes        String[]
  /**
   * Версия правил, по которым выставлен уровень.
   */
  riskRulesVersion Int      @default(0)

  // ─── Отслеживание результата ────────────────────────────────────────
  // Ценность радара определяется не тем, сколько токенов он нашёл,
  // а тем, что с ними стало после. Поэтому фиксируем состояние в момент
  // обнаружения и следим за ним дальше.

  /**
   * Капитализация в момент обнаружения — база для расчёта кратности.
   */
  mcapAtSignalUsd Decimal? @db.Decimal(24, 8)
  currentMcapUsd  Decimal? @db.Decimal(24, 8)
  /**
   * Максимум капитализации за всё время наблюдения.
   */
  peakMcapUsd     Decimal? @db.Decimal(24, 8)

  currentPriceUsd Decimal?  @db.Decimal(38, 18)
  /**
   * Во сколько раз выросла капитализация к текущему моменту.
   */
  currentMultiple Decimal?  @db.Decimal(12, 4)
  /**
   * Максимальная достигнутая кратность. Именно её показывают как результат.
   */
  peakMultiple    Decimal?  @db.Decimal(12, 4)
  /**
   * Когда был достигнут пик — показывает, успел ли бы человек выйти.
   */
  peakAt          DateTime?

  currentHolders  Int?
  holdersAtSignal Int?
  currentTop10Pct Decimal? @db.Decimal(8, 4)

  /**
   * Точки для мини-графика: [{t, p, m}] — время, цена, капитализация.
   */
  pricePoints       Json?
  lastCheckedAt     DateTime?
  /**
   * Когда последний раз забирали сделки пула для разметки кошельков.
   */
  walletsCheckedAt  DateTime?
  /**
   * Свод по кошелькам, посчитанный воркером и сохранённый здесь.
   * Денормализация сознательная: лента радара показывает до полусотни
   * карточек, и считать сигнал запросом на каждую означало бы полсотни
   * агрегаций на открытие страницы.
   */
  smartBuyers       Int       @default(0)
  smartBuyVolumeUsd Decimal   @default(0) @db.Decimal(24, 8)
  whaleBuyers       Int       @default(0)
  /**
   * Сила сигнала 0-100 с учётом давности покупок.
   */
  walletSignalScore Int       @default(0)
  /**
   * Наблюдение прекращено: пул умер либо прошло слишком много времени.
   */
  isTracking        Boolean   @default(true)

  /**
   * Уведомления по событию уже разосланы.
   */
  notified      Boolean @default(false)
  /**
   * Токен заведён в витрину по этому событию.
   */
  listedTokenId String?

  /**
   * Решения автоправила по этой находке.
   */
  fires AutoRuleFire[]

  firstSeenAt DateTime @default(now())

  @@unique([chain, address])
  @@index([firstSeenAt])
  @@index([notified, riskScore])
  @@index([isTracking, lastCheckedAt])
  @@index([isTracking, walletsCheckedAt])
  @@index([peakMultiple])
  // Индексы под сортировки ленты. Без них база при каждом обновлении
  // читает таблицу целиком и сортирует в памяти — на тысяче находок
  // это уже заметно, а растёт она непрерывно.
  //
  // Первым полем везде riskLevel: заблокированные отсекаются до
  // сортировки, и чем раньше это происходит, тем меньше строк
  // доходит до сортировки.
  @@index([riskLevel, firstSeenAt])
  @@index([riskLevel, currentMultiple])
  @@index([riskLevel, liquidityUsd])
  @@index([riskLevel, riskScore])
  @@index([riskRulesVersion])
}

// ───────────────────── Кошельки: смарт-мани и киты ──────────────────────────

/**
 * Кошелёк, замеченный в сделках по отслеживаемым токенам.
 * Метка «смарт» здесь не покупается у поставщика и не берётся из чужого
 * списка — она вычисляется из наших же наблюдений: кошелёк покупал токены,
 * которые потом выросли. Это единственный способ, который можно проверить
 * и объяснить, а не принять на веру.
 * Ключевое ограничение: метка не выдаётся, пока сделок мало. На выборке
 * из трёх покупок «100% попаданий» — это шум, а не навык.
 */
model TraderWallet {
  id      String @id @default(cuid())
  chain   Chain
  address String

  /**
   * Человеческая метка, если известна: биржа, маркетмейкер, известный фонд.
   */
  knownAs String?

  // ─── Накопленная статистика ─────────────────────────────────────────
  /**
   * /** Сколько разных токенов покупал среди отслеживаемых.
   */
  tokensBought Int @default(0)
  /**
   * Покупки, после которых токен вырастал минимум вдвое.
   */
  wins2x       Int @default(0)
  wins5x       Int @default(0)
  /**
   * Покупки, после которых токен терял более 80%.
   */
  rugs         Int @default(0)

  // ─── Контракт сводки ────────────────────────────────────────────────
  //
  // Знаменатель доли попаданий хранится, а не восстанавливается.
  // Выражение `max(wins2x, rugs)` теряло исходы между 0.2x и 2x:
  // они оцениваемые, но ни победа, ни rug. Победы — подмножество
  // оцениваемых исходов, а подмножество не определяет множество.
  //
  // NULL означает «ещё не пересчитан новыми правилами», а не ноль.
  // Умолчание стёрло бы разницу между честным нулём и старой строкой.

  /**
   * Знаменатель доли попаданий: токены с подведённым достоверным исходом.
   */
  scorableOutcomes  Int?
  /**
   * Ждут наблюдений. Не проигрыши.
   */
  pendingOutcomes   Int?
  /**
   * База кратности недостоверна: в оценку не идут.
   */
  ambiguousOutcomes Int?

  /**
   * Версия правил расчёта. Пусто — строка досталась от прежних правил.
   */
  scoreVersion     Int?
  /**
   * Когда сводка была посчитана на самом деле, а не когда прочитана.
   */
  scoreComputedAt  DateTime?
  /**
   * none | low | medium | high
   */
  scoreConfidence  String?
  /**
   * complete | partial | empty | stale
   */
  scoreCoverage    String?
  /**
   * Почему оценки нет, если её нет.
   */
  scoreReason      String?
  /**
   * Совокупный объём покупок в долларах.
   */
  volumeUsd        Decimal   @default(0) @db.Decimal(24, 8)
  /**
   * Средняя пиковая кратность по его покупкам.
   */
  avgPeakMultiple  Decimal?  @db.Decimal(12, 4)
  /**
   * Медианное время между запуском пула и его покупкой, часы.
   */
  medianEntryHours Decimal?  @db.Decimal(12, 4)

  /**
   * Итоговая оценка 0-100. Считается только при достаточной выборке,
   * иначе остаётся null — отсутствие оценки честнее выдуманной.
   */
  score Int?
  /**
   * smart | whale | early | none
   */
  label String @default("none")

  firstSeenAt  DateTime @default(now())
  lastActiveAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trades WalletTrade[]

  @@unique([chain, address])
  @@index([label, score])
  @@index([lastActiveAt])
  // Дешёвый ответ на вопрос «сколько строк ещё не пересчитано».
  @@index([scoreVersion])
}

/**
 * Отдельная покупка кошелька по отслеживаемому токену.
 * Хранится вместе с капитализацией на момент сделки: без неё невозможно
 * посчитать, во сколько раз вырос токен ПОСЛЕ входа, а именно это
 * отличает удачную покупку от покупки на пике.
 */
model WalletTrade {
  id       String       @id @default(cuid())
  walletId String
  wallet   TraderWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  chain        Chain
  tokenAddress String
  radarEventId String?

  /**
   * BUY | SELL
   */
  side           String
  amountUsd      Decimal  @db.Decimal(24, 8)
  priceUsd       Decimal? @db.Decimal(38, 18)
  /**
   * Капитализация в момент сделки — база для оценки исхода.
   */
  mcapAtTradeUsd Decimal? @db.Decimal(24, 8)
  /**
   * Возраст пула на момент покупки: чем раньше вход, тем ценнее сигнал.
   */
  poolAgeHours   Decimal? @db.Decimal(12, 4)

  txHash   String?
  tradedAt DateTime

  /**
   * Исход, проставляется позже: во сколько раз вырос токен после сделки.
   */
  outcomeMultiple Decimal?  @db.Decimal(12, 4)
  outcomeAt       DateTime?

  // Сторона входит в ключ: арбитражная транзакция может содержать
  // и покупку, и продажу по одному пулу, и без неё вторая запись
  // молча терялась бы.
  @@unique([walletId, txHash, side])
  @@index([chain, tokenAddress, tradedAt])
  @@index([radarEventId])
  @@index([outcomeMultiple])
}

/**
 * Ключ для программного доступа.
 * Нужен, чтобы скрипт мог работать от имени аккаунта: наполнять радар
 * находками, читать позиции, ставить ордера. Отдельная сущность,
 * а не пользовательский JWT, по двум причинам.
 * Первая: JWT живёт минуты и обновляется через refresh-сессию, привязанную
 * к браузеру. Скрипт на сервере так не умеет.
 * Вторая, важнее: у ключа своя область прав. Скрипту, который торгует,
 * незачем уметь менять пароль или выводить средства. Область задаётся
 * при создании и потом не расширяется.
 * Вывод средств не входит ни в одну область и не может быть выдан ключу
 * в принципе. Это не настройка, а свойство системы: ключ хранится в файле
 * на чужой машине, его нельзя защитить вторым фактором, и единственная
 * надёжная гарантия — отсутствие самой возможности.
 * Хранится SHA-256 от ключа. Утечка базы не даёт доступа.
 */
model ApiKey {
  id     String @id @default(cuid())
  name   String
  /**
   * Владелец. Действия ключа выполняются от его имени.
   */
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  /**
   * Первые символы — чтобы отличать ключи в списке. Не секрет.
   */
  prefix    String

  /**
   * Области доступа: radar:ingest | trade:read | trade:write.
   * Пустой список означает ключ без прав — такой отвергается.
   */
  scopes String[]

  isActive   Boolean @default(true)
  maxPerHour Int     @default(60)

  /**
   * Предел суммы одной сделки для этого ключа, USD.
   * Ошибка в скрипте с лишним нулём иначе стоит всего депозита.
   */
  maxOrderUsd Decimal? @db.Decimal(24, 8)

  lastUsedAt DateTime?
  usedCount  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([isActive])
  @@index([userId])
}

// ─────────────────────── Автопубликация коллов ──────────────────────────────

/**
 * Правило автоматической публикации.
 * В системе существует ровно одна активная запись: правил несколько
 * означало бы, что на одну находку могут сработать два — и надо решать,
 * какое из них главнее. Пока такой потребности нет, единственное правило
 * убирает целый класс вопросов.
 * Выключено по умолчанию и стартует в режиме наблюдения. Автоматика,
 * включённая сразу в боевом режиме, на первом же часу публикует всё,
 * что прошло недонастроенный фильтр, — и это видят пользователи.
 */
model AutoRule {
  id   String @id @default(cuid())
  name String @default("Основное правило")

  /**
   * Главный выключатель.
   */
  isEnabled Boolean @default(false)
  /**
   * Режим наблюдения: правило считается и пишет в журнал, но ничего
   * не публикует. Позволяет неделю смотреть, что бы оно наделало,
   * не рискуя витриной.
   */
  isDryRun  Boolean @default(true)

  /**
   * Сети, на которых правило работает. Пусто — все поддерживаемые.
   */
  chains Chain[]

  // ─── Условие по кошелькам: основной триггер ─────────────────────────
  /**
   * /** Минимум размеченных кошельков с историей среди покупателей.
   */
  minSmartBuyers    Int     @default(2)
  /**
   * Минимальная сила сигнала 0-100 с учётом давности покупок.
   */
  minSignalStrength Int     @default(40)
  /**
   * Минимальная суммарная покупка размеченных кошельков, USD.
   */
  minSmartVolumeUsd Decimal @default(3000) @db.Decimal(24, 8)

  // ─── Страховочные условия ───────────────────────────────────────────
  // Сигнал по кошелькам не отменяет базовой проверки токена: смарт-деньги
  // тоже заходят в honeypot, разница лишь в том, что у них хватает денег
  // на потерю.
  minLiquidityUsd Decimal @default(30000) @db.Decimal(24, 8)
  minVolume24hUsd Decimal @default(20000) @db.Decimal(24, 8)
  maxRiskScore    Int     @default(60)
  maxPoolAgeHours Int     @default(72)

  // ─── Ограничители ───────────────────────────────────────────────────
  /**
   * /** Не более скольких коллов в сутки. Защита от лавины в активный час.
   */
  maxCallsPerDay  Int @default(5)
  /**
   * Пауза между публикациями, минуты.
   */
  cooldownMinutes Int @default(60)

  // ─── Параметры создаваемого колла ───────────────────────────────────
  /**
   * /** Цели в процентах от цены входа, например [50, 100, 200].
   */
  targetPcts    Json    @default("[50, 100, 200]")
  /**
   * Стоп-лосс в процентах ниже входа.
   */
  stopLossPct   Int     @default(35)
  suggestedPct  Decimal @default(2) @db.Decimal(8, 4)
  timeHorizon   String  @default("1-3 дня")
  /**
   * Включать ли копитрейдинг у создаваемых коллов.
   */
  isCopyEnabled Boolean @default(false)
  /**
   * От чьего имени публикуются коллы.
   */
  authorId      String?

  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  fires AutoRuleFire[]
}

/**
 * Журнал решений правила.
 * Записываются и срабатывания, и отказы с причиной. Журнал только
 * успешных срабатываний не позволяет понять, почему правило молчит —
 * а это самый частый вопрос к любой автоматике.
 */
model AutoRuleFire {
  id     String   @id @default(cuid())
  ruleId String
  rule   AutoRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  radarEventId String
  radarEvent   RadarEvent @relation(fields: [radarEventId], references: [id], onDelete: Cascade)
  chain        Chain
  address      String
  symbol       String

  /**
   * FIRED | DRY_RUN | SKIPPED
   */
  outcome  String
  /**
   * Человеческое объяснение решения.
   */
  reason   String @db.Text
  /**
   * Снимок значений, на которых принято решение.
   */
  snapshot Json?

  /**
   * Созданный колл, если он был создан.
   */
  callId String?

  createdAt DateTime @default(now())

  @@unique([ruleId, radarEventId])
  @@index([ruleId, createdAt])
  @@index([outcome, createdAt])
}

enum RadarChannel {
  IN_APP
  TELEGRAM
}

/**
 * Подписка пользователя на уведомления радара со своими порогами.
 */
model RadarSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel  RadarChannel @default(IN_APP)
  isActive Boolean      @default(true)

  chains          Chain[]
  minLiquidityUsd Decimal? @db.Decimal(24, 8)
  minVolume24hUsd Decimal? @db.Decimal(24, 8)
  maxRiskScore    Int?
  /**
   * Не уведомлять о пулах старше указанного возраста.
   */
  maxPoolAgeHours Int?

  /**
   * Защита от лавины: не больше указанного числа сообщений в час.
   */
  maxAlertsPerHour Int      @default(20)
  sentLastHour     Int      @default(0)
  windowStartedAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, channel])
  @@index([isActive])
}

// ─────────────────────────── Коллы (сигналы админа) ─────────────────────────

enum CallStatus {
  DRAFT
  PUBLISHED
  HIT_TARGET
  STOPPED_OUT
  EXPIRED
  CANCELLED
}

enum CallRisk {
  LOW
  MEDIUM
  HIGH
  DEGEN
}

model Call {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  tokenId  String
  token    Token  @relation(fields: [tokenId], references: [id])
  chain    Chain

  title  String
  thesis String     @db.Text // почему проект имеет потенциал
  risk   CallRisk   @default(HIGH)
  status CallStatus @default(DRAFT)

  entryPriceUsd Decimal  @db.Decimal(38, 18)
  targets       Json // [{ priceUsd, pct }] — лестница тейков
  stopLossUsd   Decimal? @db.Decimal(38, 18)
  suggestedPct  Decimal? @db.Decimal(8, 4) // рекомендуемая доля портфеля
  timeHorizon   String? // "1-3 дня", "свинг"
  links         Json? // сайт, twitter, dexscreener

  // авто-фиксация результата
  peakPriceUsd   Decimal? @db.Decimal(38, 18)
  peakMultiple   Decimal? @db.Decimal(12, 4)
  closedPriceUsd Decimal? @db.Decimal(38, 18)
  resultPct      Decimal? @db.Decimal(12, 4)

  isCopyEnabled Boolean @default(false) // включает fan-out подписчикам

  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders Order[]

  @@index([status, publishedAt])
  @@index([chain, status])
}

// ─────────────────────────────── Копитрейдинг ───────────────────────────────

enum CopyStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum CopyPendingMode {
  ON_FILL
  MIRROR
}

enum CopySizing {
  FIXED_USD // фиксированная сумма на сделку
  PCT_EQUITY // % от капитала подписчика
  PROPORTIONAL // пропорционально доле лидера
}

model CopySubscription {
  id         String @id @default(cuid())
  followerId String
  follower   User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  leaderId   String
  leader     User   @relation("leader", fields: [leaderId], references: [id], onDelete: Cascade)

  status CopyStatus @default(ACTIVE)
  sizing CopySizing @default(PCT_EQUITY)

  /**
   * Когда копировать отложенные ордера лидера.
   * ON_FILL — рыночная копия в момент срабатывания лимитки лидера.
   * Вход гарантирован, но по цене на секунды позже и хуже.
   * MIRROR — такая же лимитка ставится сразу.
   * Цена входа та же, что у лидера, но исполнение не гарантировано,
   * и средства заморожены всё время жизни ордера.
   * По умолчанию ON_FILL: заморозка средств — не то, что человек ожидает
   * получить, не выбрав этого явно.
   */
  pendingMode    CopyPendingMode @default(ON_FILL)
  /**
   * Предел доли капитала под заморозкой в зеркалируемых ордерах.
   * Без него десяток лимиток лидера связывает все средства подписчика,
   * и на выход из открытых позиций денег не остаётся.
   */
  maxLockedShare Decimal?        @default(0.5) @db.Decimal(5, 4)

  fixedUsd          Decimal? @db.Decimal(24, 8)
  pctEquity         Decimal? @db.Decimal(8, 4) // например 5.0 = 5% капитала на сделку
  maxPerTradeUsd    Decimal? @db.Decimal(24, 8)
  maxOpenPositions  Int      @default(10)
  dailyLossLimitUsd Decimal? @db.Decimal(24, 8)
  allowedChains     Chain[]
  minLiquidityUsd   Decimal? @db.Decimal(24, 8)
  maxRiskScore      Int? // не копировать токены опаснее порога

  // Экономика: 10% от прибыли, договор фиксируется на момент подписки
  performanceFeeBps Int     @default(1000)
  highWaterMarkUsd  Decimal @default(0) @db.Decimal(24, 8)

  // накопительные метрики
  copiedTrades Int     @default(0)
  grossPnlUsd  Decimal @default(0) @db.Decimal(24, 8)
  feesPaidUsd  Decimal @default(0) @db.Decimal(24, 8)

  acceptedTermsAt DateTime // юридически: согласие с условиями комиссии
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([followerId, leaderId])
  @@index([leaderId, status])
}

// ────────────────────────────── Реестр комиссий ─────────────────────────────

enum FeeType {
  PERFORMANCE
  SWAP
  WITHDRAWAL
  NETWORK
}

enum FeeStatus {
  ACCRUED // начислена, удержана из выручки
  SETTLED // переведена на счёт платформы/лидера
  WAIVED
  REFUNDED
}

model FeeLedger {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeId String?
  trade   Trade?  @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  subscriptionId String?
  leaderId       String?

  type   FeeType
  status FeeStatus @default(ACCRUED)

  // Полная прозрачность расчёта — для споров и аудита
  basisPnlUsd      Decimal @db.Decimal(24, 8) // прибыль, с которой считалась комиссия
  feeBps           Int
  amountUsd        Decimal @db.Decimal(24, 8)
  amountToken      Decimal @db.Decimal(38, 18)
  feeTokenId       String?
  leaderShareUsd   Decimal @default(0) @db.Decimal(24, 8) // сплит лидер/платформа
  platformShareUsd Decimal @default(0) @db.Decimal(24, 8)

  calcSnapshot Json? // avgCost, qty, exitPrice — воспроизводимость расчёта
  createdAt    DateTime  @default(now())
  settledAt    DateTime?

  @@index([userId, createdAt])
  @@index([leaderId, status])
}

// ───────────────────────── Депозиты и выводы ────────────────────────────────

model Deposit {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])
  userId   String
  tokenId  String
  chain    Chain

  amount        Decimal @db.Decimal(38, 18)
  txSignature   String  @unique
  confirmations Int     @default(0)
  isCredited    Boolean @default(false)

  createdAt  DateTime  @default(now())
  creditedAt DateTime?

  @@index([userId])
}

// ───────────────────── Phase 4: future LIVE foundation ─────────────────────
// These records never reuse PAPER ids or balances. Network-facing workers are
// disabled by default; the schema only makes future reconciliation possible.

enum SolanaDepositEventState {
  DETECTED
  AWAITING_CONFIRMATIONS
  CONFIRMED
  FINALIZED
  CREDITED
  REJECTED
  REVIEW_REQUIRED
  REORGED
}

model SolanaDepositCheckpoint {
  id                String   @id
  lastProcessedSlot BigInt   @default(0)
  leaseOwner        String?
  leaseUntil        DateTime?
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model SolanaDepositEvent {
  id               String                  @id @default(cuid())
  eventKey         String                  @unique
  signature        String
  instructionIndex Int
  slot             BigInt
  blockhash        String?
  state            SolanaDepositEventState @default(DETECTED)
  mint             String?
  destination      String
  rawAmount        String
  decimals         Int?
  confirmations    Int                     @default(0)
  walletId         String?
  userId           String?
  tokenId          String?
  depositId        String?                 @unique
  rejectCode       String?
  leaseOwner       String?
  leaseUntil       DateTime?
  version          Int                     @default(0)
  observedAt       DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  finalizedAt      DateTime?
  creditedAt       DateTime?
  reorgedAt        DateTime?

  // ─── Сверка с цепочкой ──────────────────────────────────────────────
  //
  // Все поля допускают NULL намеренно. `reconciliationState IS NULL`
  // означает «ни разу не сверялось» — это не то же самое, что
  // «сверено и совпало». Значение по умолчанию стёрло бы разницу
  // между честным незнанием и проверенным фактом.
  /** Когда цепочка в последний раз подтвердила это событие. */
  lastChainSeenAt          DateTime?
  /** Когда сверка в последний раз завершилась без ошибки. */
  lastReconciledAt         DateTime?
  /** Когда транзакция перестала находиться. NULL — находится. */
  missingSince             DateTime?
  /** Сколько успешных ответов подряд сказали «такой нет». */
  consecutiveMissingChecks Int       @default(0)
  /** MATCHED | MISSING | MISMATCHED | UNREACHABLE. NULL — не сверялось. */
  reconciliationState      String?
  /** Сколько раз подряд сверка этой строки заканчивалась ошибкой. */
  reconcileAttempts        Int       @default(0)
  /** Раньше этого времени строку не берут: отступление с джиттером. */
  reconcileNotBefore       DateTime?

  @@unique([signature, instructionIndex])
  @@index([state, slot])
  @@index([destination, state])
  @@index([state, reconcileNotBefore])
}

/**
 * Докуда просмотрен отдельный адрес пополнения.
 *
 * Общий checkpoint отвечает только за адреса, которые были в книге,
 * когда он двигался. Кошелёк, заведённый позже, до сих пор не
 * просматривался ни разу, и общий край для него — не факт, а
 * предположение.
 */
model SolanaDepositAddressCursor {
  address            String   @id
  scannedThroughSlot BigInt
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/**
 * Намерение совершить транзакцию.
 *
 * Собирается сервером, подтверждается человеком, подписывается KMS.
 * Байты транзакции от клиента не принимаются никогда: проверить
 * чужую готовую структуру сложнее, чем построить свою.
 *
 * `SIGNED` здесь означает ровно «байты подписаны». Состояния
 * `SUBMITTED`, `CONFIRMED` и `FINALIZED` в этой модели отсутствуют
 * намеренно — отправки на этом этапе нет, и склеивать четыре разных
 * вопроса в один статус нельзя.
 */
model TransactionIntent {
  id        String @id @default(cuid())
  userId    String
  walletId  String
  network   String
  /** DEVNET_SELF_TRANSFER | DEVNET_SELF_SPL_TRANSFER. Список закрытый. */
  purpose   String

  // ─── Денежная часть. После APPROVED не меняется ────────────────────
  mint             String?
  /** Сумма в минимальных единицах. Строка: u64 не влезает в число. */
  rawAmount        String
  sourceAddress    String
  destinationAddress String
  /** Потолок комиссии в lamports. Тоже строкой. */
  feeLimitLamports String
  slippageBps      Int
  /** Разрешённые программы, отсортированы. Пишутся в подписываемые факты. */
  allowedProgramIds String[]

  recentBlockhash      String
  /** Высота, после которой blockhash мёртв. Строкой: значение растёт. */
  lastValidBlockHeight String
  /** SHA-256 сообщения. Само сообщение не хранится. */
  messageHash          String
  policyVersion        String

  /** DRAFT | VALIDATED | APPROVED | SIGNING | SIGNED | EXPIRED | REJECTED | FAILED. */
  state       String    @default("DRAFT")
  approvedAt  DateTime?
  approvedBy  String?

  // ─── Ключ, которым подписывают ─────────────────────────────────────
  keyProvider String?
  keyId       String?
  keyVersion  String?
  /** Короткий отпечаток публичного ключа. Сам ключ публичен, но адрес — нет. */
  keyFingerprint String?

  /** Владелец захвата на подпись. Второй захват невозможен. */
  signingClaimedBy String?
  signingClaimedAt DateTime?
  /** Подпись в base64. Публичное значение: приватного ключа здесь нет. */
  signature   String?
  signedAt    DateTime?
  failureCode String?

  /**
   * Откуда взялось намерение.
   *
   * AGENT_PROPOSAL | ADMIN_DEVNET_FIXTURE. Клиента в этом списке нет:
   * денежное намерение не рождается из данных браузера.
   */
  origin     String  @default("AGENT_PROPOSAL")
  /** Предложение, из которого выросло намерение. */
  proposalId String?
  /** Отпечаток денежной части в момент показа человеку. */
  shownFingerprint String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([userId, state])
  @@index([state, expiresAt])
  /**
   * Одно предложение — не больше одного живого намерения.
   *
   * Частичный индекс, а не проверка в коде: два параллельных
   * подтверждения иначе создали бы два намерения на одну сумму.
   */
  @@index([proposalId])
}

/**
 * Попытка подписи.
 *
 * Отдельно от намерения, потому что отвечает на другой вопрос:
 * не «чем кончилось», а «что происходило». Неоднозначный ответ KMS
 * оставляет строку, по которой видно, что вторая попытка запрещена
 * до ручного разбора.
 */
model SigningAttempt {
  id        String   @id @default(cuid())
  intentId  String
  /** CLAIMED | SUCCEEDED | FAILED | AMBIGUOUS. */
  outcome   String
  /** Безопасный машинный код. Ни ответа провайдера, ни сообщения. */
  code      String?
  keyVersion String?
  claimedBy String
  startedAt DateTime @default(now())
  endedAt   DateTime?

  @@index([intentId, startedAt])
}

/**
 * Кто подписывает.
 *
 * Связь между ключом в облаке и адресом Solana, с которого уходят
 * деньги. Создаётся только явным действием администратора:
 * автоматическая привязка означала бы, что смена ключа в облаке
 * молча меняет адрес отправителя.
 *
 * Идентификатор ресурса KMS здесь не хранится. В базу идут отпечаток
 * и адрес — по ним нельзя восстановить ни аккаунт, ни регион.
 */
model SigningIdentity {
  id            String  @id
  provider      String
  /** UNREGISTERED | REGISTERED | PAUSED. */
  state         String  @default("UNREGISTERED")
  /** Короткий отпечаток публичного ключа. Не сам ключ. */
  fingerprint   String
  /** Адрес Solana, вычисленный из публичного ключа. */
  solanaAddress String
  keyVersion    String
  algorithm     String
  network       String

  registeredBy  String?
  registeredAt  DateTime?
  /** Почему контур переведён в паузу. Безопасный машинный код. */
  pausedReason  String?
  pausedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
}

/**
 * Защёлка контура пополнений.
 *
 * Поднимается сервером при расхождении и снимается только человеком.
 * Отдельная таблица, а не поле в настройках: состояние денежного
 * контура должно переживать перезапуск и не зависеть от переменных
 * окружения, которые правятся при каждом деплое.
 */
model FundingSafetyLatch {
  id         String    @id
  /** HEALTHY | DEGRADED | PAUSED | REVIEW_REQUIRED. */
  state      String    @default("HEALTHY")
  reasonKind String?
  eventKey   String?
  raisedAt   DateTime?
  clearedAt  DateTime?
  clearedBy  String?
  updatedAt  DateTime  @updatedAt
}

enum SolanaTransactionState {
  CREATED
  QUOTED
  SIGNED
  SUBMITTED
  CONFIRMED
  FINALIZED
  FAILED
  AMBIGUOUS
  EXPIRED
}

enum LiveAgentProposalState {
  CREATED
  AWAITING_CONFIRMATION
  CONFIRMED
  REJECTED
  EXPIRED
}

model LiveAgentProposal {
  id                      String                 @id @default(cuid())
  userId                  String
  tokenId                 String?
  network                 Chain                  @default(SOLANA)
  assetAddress            String
  assetSymbol             String
  amountUsd               Decimal                @db.Decimal(24, 8)
  estimatedNetworkFeeUsd  Decimal?               @db.Decimal(24, 8)
  estimatedPlatformFeeUsd Decimal?               @db.Decimal(24, 8)
  priceImpactBps          Int?
  riskSnapshot            Json
  status                  LiveAgentProposalState @default(CREATED)
  idempotencyKey          String                 @unique
  expiresAt               DateTime
  confirmedAt             DateTime?
  rejectedAt              DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([userId, status, createdAt])
}

model SolanaTransaction {
  id                    String                 @id @default(cuid())
  proposalId            String?                @unique
  withdrawalOperationId String?                @unique
  state                 SolanaTransactionState @default(CREATED)
  idempotencyKey        String                 @unique
  signature             String?                @unique
  recentBlockhash       String?
  lastValidBlockHeight  BigInt?
  broadcastAttempts     Int                    @default(0)
  quotedInputRaw        String?
  quotedOutputRaw       String?
  actualInputRaw        String?
  actualOutputRaw       String?
  actualFeeLamports     BigInt?
  lastRpcErrorCode      String?
  submittedAt           DateTime?
  confirmedAt           DateTime?
  finalizedAt           DateTime?
  expiresAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  version               Int                    @default(0)

  @@index([state, updatedAt])
}

enum WithdrawalLifecycleState {
  REQUESTED
  LOCKED
  APPROVED
  SIGNED
  SUBMITTED
  CONFIRMED
  FINALIZED
  FAILED
  AMBIGUOUS
  CANCELLED
}

model WithdrawalOperation {
  id                       String                   @id @default(cuid())
  withdrawalId             String                   @unique
  state                    WithdrawalLifecycleState @default(REQUESTED)
  idempotencyKey           String                   @unique
  lockedAmount             Decimal                  @db.Decimal(38, 18)
  unfinalizedDepositAmount Decimal                  @default(0) @db.Decimal(38, 18)
  limitsSnapshot           Json
  complianceReviewId       String?
  transactionId            String?                  @unique
  failureCode              String?
  approvedBy               String?
  approvedAt               DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  version                  Int                      @default(0)

  @@index([state, createdAt])
}

enum ComplianceState {
  NOT_CONFIGURED
  PENDING
  REVIEW_REQUIRED
  APPROVED
  REJECTED
}

model ComplianceReview {
  id            String          @id @default(cuid())
  userId        String
  operationType String
  operationId   String
  kyc           ComplianceState @default(NOT_CONFIGURED)
  aml           ComplianceState @default(NOT_CONFIGURED)
  sanctions     ComplianceState @default(NOT_CONFIGURED)
  sourceOfFunds ComplianceState @default(NOT_CONFIGURED)
  overall       ComplianceState @default(NOT_CONFIGURED)
  providerRef   String?
  reason        String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([operationType, operationId])
  @@index([userId, overall, createdAt])
}

model SolanaReconciliationIssue {
  id        String   @id @default(cuid())
  eventKey  String
  kind      String
  expected  Json?
  actual    Json?
  status    String   @default("OPEN")
  resolvedBy String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?

  @@unique([eventKey, kind])
  @@index([status, createdAt])
}

model KmsAuditEvent {
  id         String   @id @default(cuid())
  walletId   String?
  actorId    String?
  action     String
  provider   String
  keyId      String
  keyVersion String
  status     String
  errorCode  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([action, status, createdAt])
}

enum WithdrawalStatus {
  REQUESTED
  AWAITING_2FA
  MANUAL_REVIEW
  APPROVED
  BROADCAST
  CONFIRMED
  REJECTED
  FAILED
}

model Withdrawal {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenId String
  chain   Chain

  amount       Decimal          @db.Decimal(38, 18)
  feeAmount    Decimal          @default(0) @db.Decimal(38, 18)
  toAddress    String
  status       WithdrawalStatus @default(REQUESTED)
  txSignature  String?
  reviewedBy   String?
  rejectReason String?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([userId, status])
  @@index([status])
}

// ─────────────────────────────── Аудит ──────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String // call.publish, withdrawal.approve, user.freeze, fee.waive
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

model IdempotencyKey {
  key       String   @id
  userId    String
  response  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/**
 * Живая сделка отслеживаемого кошелька.
 * Отдельно от WalletTrade намеренно. Там — разобранные экономические
 * операции, участвующие в расчёте; здесь сырой поток от провайдера,
 * который ещё предстоит разобрать. Смешивать их значило бы пускать
 * непроверенное в статистику.
 */
model WalletActivity {
  /**
   * Устойчивый ключ события. Он же защита от повторной записи.
   */
  id String @id

  chain         Chain
  walletAddress String
  tokenAddress  String
  tokenSymbol   String?

  /**
   * BUY | SELL
   */
  side           String
  quoteSymbol    String?
  quoteAmount    Decimal? @db.Decimal(38, 18)
  priceUsd       Decimal? @db.Decimal(38, 18)
  marketCapUsd   Decimal? @db.Decimal(24, 8)
  /**
   * Только для продаж: у покупки результата ещё нет.
   */
  realizedPnlUsd Decimal? @db.Decimal(24, 8)

  txHash            String?
  trackerType       Int?
  /**
   * okx_websocket | okx_rest
   */
  source            String
  /**
   * Насколько полон разбор события, 0-1.
   */
  parsingConfidence Decimal @default(1) @db.Decimal(4, 3)

  /**
   * Событие учтено в позициях кошелька.
   * Ставится true только тогда, когда для него нашлась
   * каноническая сделка из истории DEX с точным количеством
   * и пересчёт позиции прошёл успешно. Сам факт сохранения
   * события основанием не является: лента отслеживания не даёт
   * количества купленного токена, и учесть её напрямую нельзя.
   */
  appliedToLedger Boolean   @default(false)
  /**
   * pending | matched | applied | ignored | deferred | failed
   */
  ledgerState     String    @default("pending")
  ledgerAppliedAt DateTime?
  ledgerErrorCode String?
  ledgerAttempts  Int       @default(0)

  // ─── Локальный результат ─────────────────────────────────────────
  //
  // `realizedPnlUsd` выше оставлен как диагностическое число OKX.
  // Пользователю оно не показывается. Публичный результат ниже
  // считается по канонической сделке и нашей средневзвешенной
  // себестоимости.

  /**
   * Ключ точной сделки, с которой сопоставлено событие ленты.
   */
  canonicalTradeKey   String?   @unique
  /**
   * Локальный реализованный PnL этой SELL. У BUY всегда NULL.
   */
  localRealizedPnlUsd Decimal?  @db.Decimal(30, 10)
  /**
   * Локальная себестоимость проданного количества.
   */
  localCostBasisUsd   Decimal?  @db.Decimal(30, 10)
  /**
   * available | open_position | pending | incomplete_history | ambiguous
   */
  localPnlState       String?
  /**
   * Версия правил расчёта. NULL означает «ещё не пересчитано».
   */
  pnlVersion          Int?
  pnlComputedAt       DateTime?

  tradedAt   DateTime
  receivedAt DateTime @default(now())

  @@index([tradedAt])
  @@index([chain, tradedAt])
  @@index([walletAddress, tradedAt])
  @@index([tokenAddress, tradedAt])
  @@index([side, tradedAt])
  @@index([source, tradedAt])
  @@index([appliedToLedger])
  @@index([localPnlState, tradedAt])
  @@index([pnlVersion])
}

/**
 * Состояние фоновых поисков.
 * Одна строка на задачу. Нужна для двух вещей сразу: не дать двум
 * экземплярам API запустить один поиск одновременно и показать
 * администратору, когда поиск последний раз удавался.
 * Второе важнее, чем кажется: замерший поиск и спокойный рынок
 * выглядят одинаково — пустым списком.
 */
model JobState {
  name String @id

  isRunning       Boolean   @default(false)
  lastStartedAt   DateTime?
  lastCompletedAt DateTime?
  /**
   * Последний проход, завершившийся без ошибки.
   */
  lastSuccessAt   DateTime?
  durationMs      Int?
  itemCount       Int?
  errorCode       String?

  updatedAt DateTime @updatedAt
}

/**
 * Каноническая сделка из истории DEX.
 * Единственный источник точных количеств. Лента отслеживания
 * и WebSocket дают направление, цену и количество котировочного
 * токена, но не количество купленного — вычислять его делением
 * нельзя, это разные валюты.
 * Числа хранятся строками: количество с восемнадцатью знаками
 * после запятой в double теряет точность молча.
 */
model WalletEconomicTrade {
  /**
   * Ключ из кошелька, токена, направления, времени и сумм.
   */
  key String @id

  chain         Chain
  walletAddress String
  tokenAddress  String
  tokenSymbol   String?

  /**
   * BUY | SELL
   */
  side           String
  amount         Decimal  @db.Decimal(40, 18)
  valueUsd       Decimal  @db.Decimal(30, 10)
  price          Decimal  @db.Decimal(40, 20)
  marketCapUsd   Decimal? @db.Decimal(30, 10)
  /**
   * Результат по версии OKX. Для сверки, в расчёт не идёт.
   */
  providerPnlUsd Decimal? @db.Decimal(30, 10)

  provider String @default("okx_dex_history")

  // ─── Происхождение и идентичность ───────────────────────────────────
  //
  // Появились после разбора живого дефекта: одна покупка показывалась
  // много раз с одинаковым временем, потому что суммы входили в ключ.
  // Теперь ключ их не содержит, а происхождение хранится явно —
  // иначе по строке нельзя сказать, откуда она и можно ли ей верить.

  /**
   * `okx_live` или `okx_dex_history`. У источников разная идентичность.
   */
  source String @default("okx_dex_history")

  /**
   * Идентификатор события у провайдера, если он его отдаёт.
   * История DEX не отдаёт ни его, ни хеша транзакции — сверено
   * по документации. Поле оставлено под живую ленту и под будущее.
   */
  sourceEventId String?

  /**
   * Хеш транзакции. Есть только у живой ленты.
   * Именно он даёт сильную идентичность, поэтому по нему стоит
   * частичный уникальный индекс. Обычный unique здесь не защитил бы:
   * NULL не конфликтует с NULL, и строки истории дублировались бы
   * свободно.
   */
  txHash String?

  /**
   * Сколько переводов провайдера сложено в эту сделку.
   */
  fillCount Int @default(1)

  /**
   * Время первого и последнего перевода группы.
   */
  firstFillAt DateTime?
  lastFillAt  DateTime?

  /**
   * Состояние сверки: canonical | confirmed | ambiguous | superseded.
   * В статистику идут только первые два. `superseded` — старая
   * запись, свёрнутая в каноническую: история не удаляется, но
   * и вторым разом не считается.
   */
  reconciliation String @default("canonical")

  /**
   * Ключ канонической сделки, в которую свёрнута эта запись.
   */
  supersededBy String?

  tradedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletAddress, chain, tradedAt])
  @@index([walletAddress, chain, tokenAddress, tradedAt])
  // Чтение статистики отсекает свёрнутые и неоднозначные записи.
  @@index([walletAddress, chain, reconciliation])
  @@index([supersededBy])
}

/**
 * Кошельки, которым нужен пересчёт позиций.
 * Очередь с объединением: десять событий одного кошелька за двадцать
 * секунд должны дать один запрос к истории, а не десять.
 */
model WalletSyncQueue {
  /**
   * chain:wallet
   */
  id String @id

  chain         Chain
  walletAddress String

  /**
   * Когда пересчитывать: обновляется при каждом новом событии.
   */
  dueAt         DateTime
  attempts      Int       @default(0)
  lastErrorCode String?
  lastSyncAt    DateTime?
  lastSuccessAt DateTime?

  /**
   * Поколение задачи.
   * Растёт с каждым новым событием. Воркер запоминает его при
   * захвате и снимает задачу только при совпадении: иначе за время
   * выгрузки истории пришло новое событие, и снятие стёрло бы
   * работу, о которой воркер не знал. Сделка потерялась бы
   * навсегда и молча.
   */
  generation Int @default(1)

  /**
   * Аренда задачи.
   * Захват делается условным обновлением, а не парой «найти
   * и обновить»: два экземпляра API увидели бы одну строку и оба
   * сочли бы, что забрали её. Просроченная аренда перехватывается —
   * процесс, упавший с захваченной задачей, не должен блокировать
   * её навсегда.
   */
  lockedBy    String?
  leaseToken  String?
  lockedUntil DateTime?

  updatedAt DateTime @updatedAt

  @@unique([chain, walletAddress])
  @@index([dueAt, lockedUntil])
}

// ──────────────────────────── Подписки и права ──────────────────────────────

/**
 * Коды планов.
 * Технические, не публичные. Названия и цены живут там, где их может
 * менять маркетинг; здесь только то, от чего зависит доступ. Те же
 * строки в packages/core/src/entitlements.ts — расхождение между
 * двумя списками означало бы план, который база принимает, а код
 * не понимает.
 */
enum PlanCode {
  /**
   * Ни оплаты, ни действующего пробного периода.
   * Не «ничего нельзя»: продать своё, вывести своё и посмотреть свой
   * баланс можно всегда. Закрыты поиск, новые покупки и автоматика.
   */
  EXPIRED
  /**
   * Пробный период. Пять суток, один раз за всё время.
   */
  TRIAL
  PRO
  SEMI_AUTO
  FULL_AUTO
}

/**
 * Состояние договора.
 * Истёкшее и отменённое различаются намеренно. К ограничению прав
 * ведут оба, но разговор с человеком и решение по возврату —
 * разные, и восстановить причину задним числом из одного лишь
 * «неактивна» невозможно.
 */
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

/**
 * Откуда взялся план.
 * PROMO и ADMIN_GRANT отделены от оплаты не ради статистики.
 * Выданный вручную доступ рано или поздно приходится объяснять,
 * и «кто-то поставил FULL_AUTO» — не объяснение.
 */
enum SubscriptionSource {
  PAYMENT
  /**
   * Пробный период. Отдельно от промо: он не акция, а часть продукта.
   */
  TRIAL
  ADMIN_GRANT
  PROMO
  MIGRATION
}

/**
 * Оплаченный план на срок.
 * О платёжном провайдере таблица знает ровно две строки: как его
 * зовут и под каким номером у него лежит эта подписка. Провайдера
 * однажды поменяют, и переписывать из-за этого правила доступа
 * не придётся.
 * Записи не удаляются и не переписываются задним числом: история
 * планов — это то, чем отвечают на претензию по списанию.
 */
model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   PlanCode
  status SubscriptionStatus @default(ACTIVE)

  startsAt    DateTime  @default(now())
  /**
   * Когда права заканчиваются. null — бессрочно.
   */
  expiresAt   DateTime?
  cancelledAt DateTime?

  source SubscriptionSource @default(PAYMENT)

  /**
   * Номер у провайдера.
   * Нужен для сверки и для защиты от двойного начисления по одному
   * событию: повторный webhook — норма, а не сбой, и рассчитывать
   * на то, что он придёт однажды, нельзя.
   */
  externalReference String?

  /**
   * Кто выдал, если выдали вручную. Для PAYMENT остаётся пустым.
   */
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audits  EntitlementAudit[]
  /**
   * Платёж, которым выдана эта подписка.
   */
  payment SubscriptionPayment?

  /**
   * Об ограничении «один активный план на пользователя».
   * Оно есть, но описано не здесь: Prisma не умеет частичные
   * индексы, поэтому строка
   * CREATE UNIQUE INDEX "Subscription_one_active_per_user"
   * ON "Subscription" ("userId") WHERE "status" = 'ACTIVE';
   * добавлена в миграцию add_subscriptions_and_delayed_snapshots
   * вручную. Postgres проверяет её на каждой вставке, поэтому два
   * одновременных платежа не могут создать две активные подписки.
   * Первый вариант этой схемы обходился без частичного индекса:
   * была колонка activeUserId, равная userId у действующего договора
   * и пустая у прочих, под обычным @unique. Работало бы то же самое,
   * но ценой поля, которое обязано меняться синхронно со status
   * и ничего не значит само по себе. Разъехавшись со status хотя бы
   * однажды, оно перестало бы что-либо гарантировать, продолжая
   * выглядеть как гарантия. Частичный индекс выражает правило прямо
   * и синхронизировать не с чем.
   * Плата за это — объект, о котором Prisma не знает. Он живёт
   * в SQL миграции, воспроизводится в теневой базе вместе с ней
   * и потому не считается расхождением; но `migrate diff` от базы
   * к схеме будет его показывать, и scripts/migrations-drift.sh
   * знает об этом исключении поимённо.
   */

  /**
   * О пробном периоде.
   * «Один пробный период на пользователя за всё время» тоже описано
   * не здесь, и по той же причине — Prisma не умеет частичные
   * индексы:
   * CREATE UNIQUE INDEX "Subscription_one_trial_per_user"
   * ON "Subscription" ("userId") WHERE "plan" = 'TRIAL';
   * Именно «за всё время», а не «одновременно». Разница стоит денег:
   * ограничение на один *действующий* пробный период обходится
   * ожиданием пяти суток и повторной активацией, и обходится
   * бесконечно.
   * Обычное `@@unique([userId, plan])` тут не годится: оно заодно
   * запретило бы купить PRO во второй раз после отмены первого,
   * то есть сломало бы обычную покупку ради защиты от повторного
   * пробного периода.
   * Побочное следствие: строку пробного периода нельзя удалять.
   * Она и есть память о том, что период уже был.
   */

  @@unique([source, externalReference])
  /**
   * Действующий план пользователя и история его планов.
   */
  @@index([userId, status, startsAt])
  /**
   * Кого пора перевести на бесплатный: срок вышел, статус ещё ACTIVE.
   */
  @@index([status, expiresAt])
  /**
   * Что выдавали руками и кто это делал.
   */
  @@index([source, createdByUserId])
}

/**
 * Журнал смены плана.
 * Отвечает на вопросы, которые задают позже и по одному: почему
 * доступ пропал, кто выдал повышенный план, когда именно человек
 * перестал получать мгновенные данные. Ответ «наверное, истекла»
 * ни на один из них не годится.
 * Связи с User намеренно нет, только идентификатор. Журнал должен
 * пережить удаление аккаунта: разбирательства начинаются как раз
 * после ухода человека, и каскад стёр бы единственное свидетельство.
 */
model EntitlementAudit {
  id     String @id @default(cuid())
  userId String

  /**
   * Договор, которого касается запись. null для системных переходов.
   */
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /**
   * Что было и что стало. Оба поля обязательны: «стало FREE» без
   * «было FULL_AUTO» не отвечает ни на один вопрос.
   */
  previousPlan PlanCode
  nextPlan     PlanCode

  /**
   * Человекочитаемая причина: истечение, отмена, оплата, выдача.
   */
  reason String
  source SubscriptionSource

  /**
   * Кто выполнил действие. null означает, что его выполнило время.
   */
  actorUserId String?

  /**
   * Подробности перехода.
   * Только то, что не является персональными данными и не является
   * секретом: идентификатор события провайдера, код причины, срок.
   * Ни платёжных реквизитов, ни заголовков запроса — журнал читают
   * люди, у которых нет прав на такие данные.
   */
  metadata Json?

  occurredAt DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([subscriptionId, occurredAt])
  @@index([actorUserId, occurredAt])
}

// ───────────────────────── Оплата подписок ──────────────────────────────────
//
// Отдельный контур, не смешанный с пополнением торгового кошелька.
// Это два разных денежных потока: оплата подписки — выручка платформы
// и обратно не возвращается; пополнение остаётся деньгами пользователя
// и выводится в любой момент. Общая таблица однажды привела бы к тому,
// что абонентская плата списалась из торгового баланса или наоборот.

enum PaymentProvider {
  BRIDGE
  COINBASE
}

/**
 * Состояние платежа.
 * Собственное, а не провайдерское. Bridge однажды переименует статус
 * или добавит новый, и если в базе лежит его строка, менять придётся
 * схему, отчёты и правила выдачи доступа разом.
 * Движение только вперёд — за этим следит packages/core/payment-state.
 */
enum PaymentState {
  CREATED
  KYC_REQUIRED
  AWAITING_FUNDS
  IN_REVIEW
  FUNDS_RECEIVED
  PAYMENT_SUBMITTED
  PAID
  UNDELIVERABLE
  FAILED
  MANUAL_REVIEW_REQUIRED
}

enum KycState {
  NOT_STARTED
  INCOMPLETE
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAUSED
  OFFBOARDED
}

/**
 * Связь пользователя с платёжным провайдером.
 * Хранится минимум: идентификаторы и статусы. Ни документов,
 * ни налоговых номеров, ни адресов, ни ответов анкеты — всё это
 * остаётся у провайдера, для того размещённая проверка личности
 * и выбрана. Данные, которых у нас нет, невозможно потерять.
 */
model PaymentCustomer {
  id       String          @id @default(cuid())
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider PaymentProvider @default(BRIDGE)

  /**
   * Идентификатор ссылки на проверку у провайдера.
   */
  externalKycLinkId  String?
  /**
   * Идентификатор клиента у провайдера. Появляется после проверки.
   */
  externalCustomerId String?

  kycState    KycState @default(NOT_STARTED)
  tosAccepted Boolean  @default(false)

  /**
   * Ссылки на размещённые у провайдера страницы.
   * Не секреты, но и не вечные: провайдер меняет их при пересоздании
   * проверки. Хранятся, чтобы человек мог вернуться к незаконченной
   * проверке, не начиная заново.
   */
  kycUrl String?
  tosUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SubscriptionPayment[]

  /**
   * Один клиент на пользователя у каждого провайдера.
   */
  @@unique([userId, provider])
  @@index([externalCustomerId])
}

/**
 * Оплата подписки.
 * Цена, срок и сеть записываются в момент создания и больше
 * не меняются. Если завтра тариф подорожает, уже начатый платёж
 * обязан завершиться по старой цене: человек видел одну сумму,
 * платит другую — это обман, даже если разница в его пользу.
 */
model SubscriptionPayment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerId String?
  customer   PaymentCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  plan PlanCode

  // ─── Снимок каталога на момент покупки ──────────────────────────
  /**
   * /** Цена в валюте расчёта. Строка: деньги не считают через Float.
   */
  priceAmount   Decimal @db.Decimal(24, 8)
  priceCurrency String
  termDays      Int

  /**
   * Чем платит человек и сколько.
   */
  sourceCurrency String
  sourceAmount   Decimal @db.Decimal(24, 8)

  /**
   * Куда приходит результат конвертации.
   */
  destinationCurrency String
  destinationChain    String
  destinationAddress  String

  provider           PaymentProvider @default(BRIDGE)
  /**
   * Идентификатор операции у провайдера.
   * У Bridge это перевод, у Coinbase — транзакция Onramp. Поле одно
   * намеренно: смысл у них общий — «то, что провайдер считает нашей
   * операцией», — и уникальное ограничение ниже одинаково защищает
   * от того, чтобы одна операция выдала подписку дважды.
   */
  providerTransferId String?

  /**
   * Ссылка на платёж для размещённой страницы оплаты.
   * Уникальна на каждую покупку, а не на пользователя: по ней
   * запрашивается состояние транзакции, и постоянный идентификатор
   * человека вернул бы все его покупки разом. Вторая покупка того же
   * плана слилась бы с первой.
   * Персональных данных не содержит: строка уходит в адресную строку
   * браузера и оседает в истории и журналах прокси.
   */
  partnerUserRef String? @unique

  /**
   * До какого момента годна ссылка на оплату. Токен не хранится.
   */
  checkoutExpiresAt DateTime?
  /**
   * Наш ключ идемпотентности.
   * Уходит провайдеру заголовком и хранится здесь. Повтор запроса
   * с тем же ключом не создаёт второй перевод — ни у нас, ни у него.
   */
  clientReference   String    @unique

  state PaymentState @default(CREATED)

  /**
   * Инструкции для перевода. Показываются только владельцу платежа.
   */
  depositMessage       String?
  depositBankName      String?
  depositAccountNumber String?
  depositRoutingNumber String?

  /**
   * Что получилось на самом деле. Заполняется по завершении.
   */
  deliveredAmount Decimal? @db.Decimal(24, 8)
  providerFee     Decimal? @db.Decimal(24, 8)
  exchangeFee     Decimal? @db.Decimal(24, 8)

  /**
   * Фактическая покупка со стороны провайдера.
   * Отдельно от снимка каталога: там записано, что человек заказывал,
   * здесь — что он купил. Расхождение между ними и есть повод
   * для ручного разбора, и увидеть его можно, только храня оба.
   * Явные колонки, а не JSON: по этим значениям принимается решение
   * о выдаче подписки, и прятать их в бесструктурное поле значит
   * лишиться и проверок типов, и возможности что-либо посчитать.
   */
  purchaseAmount   Decimal? @db.Decimal(24, 8)
  purchaseCurrency String?
  purchaseNetwork  String?

  /**
   * Сколько человек заплатил деньгами и в какой валюте.
   */
  paymentSubtotal Decimal? @db.Decimal(24, 8)
  paymentTotal    Decimal? @db.Decimal(24, 8)
  paymentCurrency String?
  /**
   * Комиссия сети, которую провайдер удержал деньгами.
   */
  networkFee      Decimal? @db.Decimal(24, 8)

  /**
   * Адрес, на который провайдер отправил покупку.
   */
  deliveredToAddress String?
  /**
   * Вид транзакции у провайдера. Нужен для проверки допустимости.
   */
  providerTxType     String?
  destinationTxHash  String?
  receiptUrl         String?

  /**
   * Почему платёж отправлен на разбор. Для поддержки, не для клиента.
   */
  reviewReason String?

  /**
   * Подписка, выданная этим платежом. Ровно одна.
   */
  grantedSubscriptionId String?       @unique
  grantedSubscription   Subscription? @relation(fields: [grantedSubscriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  /**
   * Один перевод у провайдера — один наш платёж.
   * Защита от того, что два наших платежа окажутся привязаны
   * к одному переводу и один перевод выдаст доступ дважды.
   */
  @@unique([provider, providerTransferId])
  @@index([userId, createdAt])
  @@index([state, createdAt])
}

/**
 * Полученное событие провайдера.
 * Существует ради одного: повторная доставка не должна выдавать
 * подписку второй раз. Провайдер повторяет вебхуки при любой
 * неуверенности в доставке — это норма, а не сбой.
 * Тело события не хранится. В нём персональные данные и подробности
 * платежа, а для идемпотентности хватает идентификатора.
 */
model WebhookReceipt {
  id       String          @id @default(cuid())
  provider PaymentProvider @default(BRIDGE)

  /**
   * Идентификатор события у провайдера. Ключ идемпотентности.
   */
  eventId        String
  /**
   * Тип события: transfer.updated и подобные.
   */
  eventType      String
  /**
   * Когда событие создано у провайдера.
   */
  eventCreatedAt DateTime

  /**
   * Что мы с ним сделали.
   */
  outcome   String
  /**
   * Наш платёж, если событие удалось сопоставить.
   */
  paymentId String?

  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([receivedAt])
}
