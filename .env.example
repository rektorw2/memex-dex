# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://memex:memex@localhost:5432/memex?schema=public
# Прямое подключение для миграций. Нужно только в облаке: строка БЕЗ -pooler.
# Локально не заполняется — миграции идут по DATABASE_URL.
DIRECT_DATABASE_URL=
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-32-bytes-minimum-secret-value
JWT_TTL=15m
REFRESH_TTL=30d
# Адреса фронтенда, которым разрешён доступ к API в production (через запятую).
# В разработке не используется — там разрешены любые источники.
CORS_ORIGINS=

# ─── Custody / KMS ───────────────────────────────────────────────────────
# ВАЖНО: в проде НЕ использовать local. Только aws-kms / gcp-kms / hashicorp-vault.
KMS_PROVIDER=local                     # local | aws-kms | gcp-kms
KMS_LOCAL_MASTER_KEY=                  # 32-байтный ключ в base64 (только dev)
AWS_KMS_KEY_ID=
HOT_WALLET_MAX_USD=25000               # выше — принудительный вывод в cold storage

# ─── Chains ──────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BNB_RPC_URL=https://bsc-dataseed.binance.org
RHC_RPC_URL=                           # Robinhood Chain (Arbitrum Orbit L2)
RHC_CHAIN_ID=

# ─── Исполнение (агрегаторы DEX) ─────────────────────────────────────────
# AI-разбор токенов. Необязательно: без ключа собираются только факты
# из бесплатных источников (GoPlus, GeckoTerminal), без трактовки модели.
# Ключ: https://aistudio.google.com/apikey — бесплатный тариф ~250-1000
# запросов в сутки на моделях Flash.
# ─── OKX Onchain OS ──────────────────────────────────────────────────
# Основной источник списка токенов, рыночных данных и расширенной
# проверки безопасности. Бесплатная регистрация в Developer Portal
# на web3.okx.com.
#
# Без ключей терминал не ломается, но список строится на запасном
# источнике (GeckoTerminal), а расширенная проверка не работает.
# Проверенных токенов при этом не будет: непроверенное безопасным
# не считается.
#
# Читаются ТОЛЬКО на сервере. В клиентский бандл не попадают никогда —
# за этим следит тест apps/api/src/lib/no-secrets.test.ts.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_PROJECT_ID=
OKX_WS_ENABLED=true
OKX_SIGNAL_REST_FALLBACK_INTERVAL_MS=60000

# Те же ключи под именами из документации OKX. Заполнять нужно
# один из вариантов, не оба.
# OKX_SECRET_KEY=
# OKX_API_PASSPHRASE=

# Уведомления радара в Telegram. Токен бота у @BotFather.
TELEGRAM_BOT_TOKEN=
# Paper-уведомления автономного агента администратору. По умолчанию выключены.
TELEGRAM_AGENT_NOTIFICATIONS_ENABLED=false
TELEGRAM_AGENT_CHAT_ID=

# Ниже этого порога ликвидности радар молчит вообще
RADAR_MIN_LIQUIDITY_USD=20000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

JUPITER_API_URL=https://quote-api.jup.ag/v6
ZEROX_API_URL=https://api.0x.org
ZEROX_API_KEY=
EXECUTION_MODE=paper                   # paper | live  — paper не отправляет транзакции

# ─── Экономика ───────────────────────────────────────────────────────────
PERFORMANCE_FEE_BPS=1000                # 10% от прибыли копитрейд-сделки
PLATFORM_SWAP_FEE_BPS=0                 # опциональная комиссия за своп
FEE_COLLECTOR_SOLANA=
FEE_COLLECTOR_EVM=

# ─── Риск-лимиты ─────────────────────────────────────────────────────────
MAX_SLIPPAGE_BPS=300
MIN_LIQUIDITY_USD=15000
COPY_MAX_ALLOCATION_PCT=25

# ─── Почта ───────────────────────────────────────────────────────────────
# Подтверждение адреса обязательно перед бесплатным периодом, поэтому
# неработающая доставка равна неработающей регистрации.
#
#   disabled — писем нет. API честно отвечает EMAIL_DELIVERY_UNAVAILABLE.
#   console  — письмо пишется в журнал, код возвращается в ответе.
#              Только для разработки: в production приложение не стартует.
#   resend   — настоящая отправка через api.resend.com.
#   smtp     — настоящая отправка через SMTP, включая Gmail.
EMAIL_PROVIDER=console
# Отправитель: «Имя <адрес@домен>» либо просто адрес.
# Домен должен быть подтверждён в панели провайдера, иначе письма отвергаются.
EMAIL_FROM=Memex DEX <no-reply@example.test>
# Ключ Resend. Нужен только при EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# SMTP. Для Gmail: smtp.gmail.com, порт 465, secure=true; SMTP_PASS —
# отдельный 16-значный пароль приложения Google, не пароль аккаунта.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Публичное имя продукта: уходит в тему письма.
PUBLIC_APP_NAME=Memex DEX
PUBLIC_APP_URL=http://localhost:3000

# ─── Оплата подписок (Bridge) ────────────────────────────────────────────
# Выключено по умолчанию. Каталог тарифов при этом работает: посмотреть
# цены можно и без возможности заплатить, а вот показать кнопку оплаты,
# за которой ничего нет, нельзя.
#
# Это выручка платформы, а не пополнение торгового кошелька
# (FUNDING_ENABLED) — два разных денежных потока.
BRIDGE_PAYMENTS_ENABLED=false
BRIDGE_API_KEY=
BRIDGE_API_BASE_URL=https://api.bridge.xyz/v0
# Открытый ключ конкретного webhook-адреса. Выдаётся при его включении
# в панели Bridge. Формат PEM, в одну переменную с переводами строк.
BRIDGE_WEBHOOK_PUBLIC_KEY=
# Куда Bridge присылает USDC. Единственный адрес выручки.
SUBSCRIPTION_TREASURY_SOLANA_ADDRESS=
# Насколько старое событие ещё принимается.
BRIDGE_WEBHOOK_MAX_AGE_SECONDS=600

# ─── Выбор платёжного провайдера ─────────────────────────────────────────
# disabled | bridge | coinbase. Одновременно работает ровно один: два
# включённых означали бы два места, куда приходят деньги, и вопрос
# «какое из них настоящее» при первом расхождении.
#
# Выбор касается только новых покупок. Уже начатые платежи другого
# провайдера продолжают читаться, обрабатываться и выдавать подписку.
SUBSCRIPTION_PAYMENT_PROVIDER=disabled

# ─── Оплата подписок (Coinbase Onramp) ───────────────────────────────────
# Второй провайдер. Человек платит картой или банком на странице
# Coinbase, а нам приходит USDC в Solana — на тот же адрес выручки,
# что и у Bridge.
#
# Проверка личности происходит внутри страницы оплаты: отдельного шага
# KYC у этого провайдера нет.
COINBASE_ONRAMP_ENABLED=false
# sandbox | production. В песочнице деньги не двигаются, и интерфейс
# показывает это явно. В production режим sandbox запрещён проверкой
# при старте.
COINBASE_ONRAMP_MODE=sandbox
# Ключ CDP. Идентификатор — не секрет, ключ — секрет, и в файл
# он не пишется никогда.
COINBASE_CDP_API_KEY_ID=
COINBASE_CDP_API_KEY_SECRET=
# Секрет подписи вебхука. Свой у каждого адреса.
COINBASE_WEBHOOK_SECRET=
# Куда провайдер вернёт браузер после оплаты. Возврат сюда доступа
# не даёт — состояние перечитывается у провайдера.
COINBASE_REDIRECT_URL=http://localhost:3000/checkout
# Насколько старое событие ещё принимается.
COINBASE_WEBHOOK_MAX_AGE_SECONDS=300
# Адрес, подставляемый в песочнице вместо настоящего. Из RFC 5737,
# документационный диапазон.
COINBASE_SANDBOX_CLIENT_IP=192.0.2.1
